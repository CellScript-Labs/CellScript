module client
use foreign::verify as verify_document

// This local layout describes a foreign observation, without consume/create
// authority. Four LE words preserve each complete 32-byte hash.
resource Document has store {
    namespace0: u64, namespace1: u64,
    category: u64, serial: u64,
    digest0: u64, digest1: u64, digest2: u64, digest3: u64,
}

// This Lock is a one-shot observation condition, not an issuer signature or a
// substitute for executing the selected Document Type group.
public lock verify(witness handle: InstanceScriptHandle<foreign>) -> bool {
    verification
    ckb::require_instance_script_participant_from_args(
        ckb::cell_dep(0), handle, ckb::input<Document>(1),
    )
    true
}
