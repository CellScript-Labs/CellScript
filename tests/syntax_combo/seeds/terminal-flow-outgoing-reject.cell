// audit: phase=reject_compile
// audit: contains=terminal state 'Done' cannot have an outgoing transition
module cellscript::audit::seed_terminal_flow_outgoing_reject

enum State {
    Start,
    Done,
}

resource Ticket {
    state: State,
}

flow Ticket.state {
    initial Start;
    terminal Done;

    Start -> Done;
    Done -> Start;
}
