// audit:edition=2027
// audit:phase=accept

module cellscript::audit::edition_2027_lock_script;

resource Vault has store {
    owner: Address,
}

lock_script unlock(
    protected vault: Vault,
    lock_args owner: Address,
    witness claimed_owner: Address,
) {
    require vault.owner == owner;
    require claimed_owner == owner;
    true
}
