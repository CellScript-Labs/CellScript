// audit:edition=2027
// audit:phase=accept
// audit:action=verify
module cellscript::audit::authoring_action;

fn threshold() -> u64 { 7 }

action verify(witness value: u64) -> u64 {
    let expected = threshold();
    if value > 0 {
        require value == expected else UnexpectedValue;
    } else {
        require false, "positive value required";
    }
    return 0;
}
