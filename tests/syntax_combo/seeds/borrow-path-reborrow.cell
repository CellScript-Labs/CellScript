// audit: phase=accept
// audit: borrow_scope=inspect
// audit: borrow_view_type=View<u64>
module cellscript::audit::seed_borrow_path_reborrow;

resource Token has consume, burn { amount: u64, }

action inspect(token: Token) -> u64 {

        borrow token.amount as amount_view {
            borrow amount_view as again {
                require *again > 0;
            }
        }
        destroy token;
        return 0;
}
