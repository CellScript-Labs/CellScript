// audit: phase=accept
module cellscript::audit::seed_bounded_collection

struct Payout {
    owner: Address,
    amount: u64,
}

resource Token has store, create, consume {
    owner: Address,
    amount: u64,
}

action batch(input inputs: BoundedCellSet<Token, 16>, witness payouts: BoundedList<Payout, 16>) -> u64 {
    verification
        consume_each token in inputs {
            require token.amount > 0
        }
        create_each payout in payouts {
            require payout.amount > 0
            create Token { owner: payout.owner, amount: payout.amount }
        }
        return 0
}
