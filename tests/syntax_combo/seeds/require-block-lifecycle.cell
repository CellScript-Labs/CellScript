// audit: phase=reject_compile
// audit: contains=require block
// audit: contains=verifier-boundary syntax
module cellscript::audit::seed_require_block_lifecycle;

resource Coin has store, create, consume, replace, burn, relock {
    amount: u64,
    nonce: u64,
}

receipt Voucher -> Coin has create, consume, burn {
    amount: u64,
    nonce: u64,
    holder: Address,
}

action bad(input voucher: Voucher,  output coin: Coin) {

        require {
            std::receipt::claim(voucher, coin, voucher.holder) {
                amount,
                nonce,
            },
        };
}
