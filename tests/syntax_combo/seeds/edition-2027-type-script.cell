// audit:edition=2027
// audit:phase=accept

module cellscript::audit::edition_2027_type_script;

resource Token has store, replace, relock {
    owner: Address,
    amount: u64,
}

type_script transfer(
    input token: Token,
    witness recipient: Address,
    output next: Token,
) {
    require token.amount > 0;

    replace token -> next {
        data {
            owner = same,
            amount = same,
        };
        type_script = same;
        lock = exact(recipient);
        capacity = same;
    }
}
