// audit: phase=accept
module cellscript::audit::seed_bitwise_shift;

fn mix(value: u128, mask: u128, count: u64) -> u128 {
    return ((value & mask) | (value ^ mask)) >> count;
}

action verify(value: u128, mask: u128, count: u64, expected: u128) -> bool {

        return (mix(value, mask, count) == expected);
}
