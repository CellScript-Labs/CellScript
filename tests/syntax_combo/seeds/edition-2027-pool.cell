// audit:edition=2027
// audit:phase=accept

module cellscript::audit::edition_2027_pool;

resource Token has store, create, consume {
    owner: Address,
    amount: u64,
}

type_script merge(
    input left: Token,
    input right: Token,
    witness recipient: Address,
    output merged: Token,
) {
    require left.amount > 0;

    audit settlement_policy {
        expected_evidence = external_policy(recipient);
    }

    pool value_flow {
        inputs {
            left,
            right
        };
        outputs {
            merged
        };
        data {
            owner {
                merged = recipient,
            },
            amount = conserve,
        };
        lock {
            merged = exact(recipient),
        };
    }
}
