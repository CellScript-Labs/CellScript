// audit:edition=2027
// audit:phase=accept

module cellscript::audit::group_branch_successor;

resource Token has store, replace, relock { amount: u64, }

type_script route(
    input left: Token,
    input right: Token,
    witness recipient: ScriptHash,
    output first: Token,
    output second: Token,
) {
    let amount = left.amount;
    if amount == 8 {
        replace left -> first {
            data { amount = same, };
            lock = exact_hash(recipient);
            type_script = same;
            capacity = same;
        }
        replace right -> second {
            data { amount = same, };
            lock = exact_hash(recipient);
            type_script = same;
            capacity = same;
        }
    } else {
        require amount == 9;
        replace left -> second {
            data { amount = same, };
            lock = exact_hash(recipient);
            type_script = same;
            capacity = same;
        }
        replace right -> first {
            data { amount = same, };
            lock = exact_hash(recipient);
            type_script = same;
            capacity = same;
        }
    }
}
