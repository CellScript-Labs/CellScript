// audit:edition=2027
// audit:phase=accept

module cellscript::audit::edition_2027_retire_fresh;

resource Note has store, create, consume, burn identity(field(note_id)) {
    note_id: u64,
    owner: Address,
    amount: u64,
}

type_script rollover(
    input expired: Note,
    witness next_id: u64,
    witness recipient: Address,
    output next: Note,
) {
    require expired.amount == 0;

    retire expired {
        absence = field(note_id);
    }
    fresh next {
        data {
            note_id = next_id,
            owner = recipient,
            amount = 0,
        };
        identity = field(note_id);
        lock = exact(recipient);
    }
}
