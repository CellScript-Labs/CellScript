#!/usr/bin/env bash

if [[ -n "${CLANG:-}" ]]; then
    printf '%s\n' "$CLANG"
    exit 0
fi

candidates=(
    clang
    clang-16
    clang-17
    clang-18
    clang-19
    clang-20
    clang-21
    clang-22
)

brew_prefix="$(brew --prefix 2>/dev/null || true)"
if [[ -n "$brew_prefix" ]]; then
    candidates+=(
        "$brew_prefix/opt/llvm/bin/clang"
        "$brew_prefix/opt/llvm@19/bin/clang"
        "$brew_prefix/opt/llvm@20/bin/clang"
        "$brew_prefix/opt/llvm@21/bin/clang"
        "$brew_prefix/opt/llvm@22/bin/clang"
    )
fi

for candidate in "${candidates[@]}"; do
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    version="$($candidate --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p' | head -n 1)"
    if [[ -n "$resolved" && -x "$(dirname "$resolved")/llvm-ar" && -n "$version" && "$version" -ge 16 ]]; then
        printf '%s\n' "$resolved"
        exit 0
    fi
done

printf 'Cannot find clang version 16 or newer\n' >&2
exit 1
