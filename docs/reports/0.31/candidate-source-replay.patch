+git -C "$BASELINE_DIR" checkout --detach "$BASE_COMMIT"
+git -C "$BASELINE_DIR" apply --unidiff-zero --intent-to-add "$ROOT_DIR/docs/reports/0.31/baseline-replay.patch"
