diff --git a/src/codegen/scalar_slots.rs b/src/codegen/scalar_slots.rs
index 3d3de77a..c53e8a3e 100644
--- a/src/codegen/scalar_slots.rs
+++ b/src/codegen/scalar_slots.rs
@@ -10,6 +10,19 @@ use super::*;
 type Variables = BTreeSet<usize>;
 type Effect = (Variables, Variables);

+/// The ordinary scalar binary emitter ends with the normalized result in t0.
+/// Constants, loads, stores, calls and helper paths deliberately do not carry
+/// this fact. All values are still stored to their existing stack slots.
+pub(super) fn retained_scalar_binary(instruction: &IrInstruction) -> Option<usize> {
+    let IrInstruction::Binary { dest, left, right, .. } = instruction else { return None };
+    if !scalar(&dest.ty) { return None; }
+    let eligible = |operand: &IrOperand| match operand {
+        IrOperand::Var(var) => scalar(&var.ty),
+        IrOperand::Const(value) => matches!(value, IrConst::U8(_) | IrConst::U16(_) | IrConst::U32(_) | IrConst::U64(_) | IrConst::Bool(_)),
+    };
+    (eligible(left) && eligible(right)).then_some(dest.id)
+}
