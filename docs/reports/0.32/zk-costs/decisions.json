  "decisions": [
    {
      "candidate": "four Rayon workers",
      "decision": "reject as default",
      "reason": "Slower requests/proving in both cases; small RSS reduction does not justify default latency regression."
    },
    {
      "candidate": "reuse checked PK in an application process",
      "decision": "retain existing native API capability; defer automatic CLI cache",
      "reason": "Measured lower request latency, but process RSS remains about 592 MiB. Native callers already own a checked PK. A persistent CLI service needs authenticated key/cache invalidation and secret lifetime policy; no new daemon or implicit trust change is justified here."
    },
    {
      "candidate": "four workers plus key reuse",
      "decision": "reject as default",
      "reason": "Measured slower than automatic threading plus reuse; no additional application latency benefit."
    },
    {
      "candidate": "gzip proof transport",
      "decision": "reject",
      "reason": "All six 128-byte canonical proofs expand; changing the admitted codec has no byte benefit."
    },
    {
      "candidate": "cross-transaction batching",
      "decision": "defer",
      "reason": "Independent raw transaction/UTXO conflicts cannot be merged by transport; requires a bounded joint statement and authorization policy, separate from the existing single-state contract."
    },
    {
      "candidate": "aggregation or recursion",
      "decision": "defer",
      "reason": "No admitted aggregate relation, aggregation keys, recursive verifier or setup/resource contract; observed key-load overhead can be addressed through the existing native API without this trust expansion."
    },
    {
      "candidate": "additional proof systems",
      "decision": "defer without profile proposal",
      "reason": "No selected scheme/implementation with exact CKB verifier, statement/codec/key/setup and measured application advantage. No new profile is proposed or admitted."
    }
  ],
