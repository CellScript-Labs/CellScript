+    scalar(&dest.ty).then_some(dest.id)
+}
+
+pub(super) fn retention_consumer(instruction: &IrInstruction) -> bool {
+    matches!(instruction, IrInstruction::Binary { .. }) && retained_t0(instruction).is_some()
+}
+
+fn scalar_constant(value: &IrConst) -> bool {
+    matches!(value, IrConst::Bool(_) | IrConst::U8(_) | IrConst::U16(_) | IrConst::U32(_) | IrConst::U64(_))
+}
+
+fn scalar_operand(operand: &IrOperand) -> bool {
+    match operand {
