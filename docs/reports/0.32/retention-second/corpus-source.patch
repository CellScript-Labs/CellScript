@@ -0,0 +1,235 @@
+//! Compare one emitter transformation on identical typed IR and options.
+//! These probes do not replace checked full-compiler corpus/backend evidence.
+
+use super::*;
+use ckb_testtool::{
+    ckb_script::ScriptGroupType,
+    ckb_types::{bytes::Bytes, packed, prelude::*},
+};
+use serde_json::{json, Value};
+
+#[path = "../../tests/support/ckb_script_runner.rs"]
+#[allow(dead_code)]
+mod ckb_script_runner;
+#[path = "../../tests/support/cost_measurement.rs"]
+#[allow(dead_code)]
+mod cost_measurement;
+#[path = "../../tests/support/cost_memory.rs"]
+mod cost_memory;
+#[path = "../../tests/support/cost_provenance.rs"]
+#[allow(dead_code)]
+mod cost_provenance;
+#[path = "../../tests/support/cost_trace.rs"]
+mod cost_trace;
+
+fn module(source: &str) -> IrModule {
+    let mut ast = crate::parser::parse(&crate::lexer::lex(source).unwrap()).unwrap();
+    crate::types::check(&ast).unwrap();
+    crate::optimize::optimize_module(&mut ast, 3).unwrap();
+    crate::ir::generate(&ast).unwrap()
+}
+
+fn generator(enabled: bool) -> CodeGenerator {
+    let mut generator = CodeGenerator::new(CodegenOptions { opt_level: 3, ..CodegenOptions::default() });
+    generator.scalar_retention_enabled = enabled;
+    generator
+}
+
+fn action(body: &str) -> String {
+    format!("module retained_probe\naction verify(witness a: u64, witness b: u64, witness expected: u64) {{ verification\n{body}\n}}")
+}
+
+fn probe(name: &str, source: &str, args: &[crate::EntryWitnessArg], valid: bool) -> Value {
+    let mut ir = module(source);
+    let ir_mutation = if name == "duplicate-ssa-operands" {
+        let mut changed = false;
+        for item in &mut ir.items {
+            if let IrItem::Action(action) = item {
+                for instruction in action.body.blocks.iter_mut().flat_map(|block| &mut block.instructions).rev() {
+                    if let IrInstruction::Binary { op: BinaryOp::Sub, left, right, .. } = instruction {
+                        assert!(matches!(right, IrOperand::Var(_)));
+                        *left = right.clone();
+                        changed = true;
+                        break;
+                    }
+                }
+            }
+        }
+        assert!(changed);
+        Some("set the last scalar subtraction's left operand to its right SSA value; expected result is zero")
+    } else {
+        None
+    };
+    let expected_call = match name {
+        "call-clobber" => Some(("perturb", 1)),
+        "outgoing-nine-arguments" => Some(("leaf", 9)),
+        _ => None,
+    };
+    if let Some((callee, argument_count)) = expected_call {
+        assert!(
+            ir.items.iter().any(|item| match item {
+                IrItem::Action(action) => action.body.blocks.iter().flat_map(|block| &block.instructions).any(|instruction| {
+                    matches!(instruction, IrInstruction::Call { func, args, .. } if func == callee && args.len() == argument_count)
+                }),
+                _ => false,
+            }),
+            "{name}: required call was optimized away"
+        );
+    }
+    let metadata = crate::compile_metadata_from_ir(&ir, ArtifactFormat::RiscvElf, TargetProfile::Ckb, crate::CURRENT_EDITION, None);
+    let action = metadata.actions.iter().find(|action| action.name == "verify").unwrap();
+    let payload = action.entry_witness_args(args).unwrap();
+    let mut fixture = ckb_script_runner::build_simple_fixture(Bytes::new(), 1, 1);
+    fixture.witnesses = vec![packed::WitnessArgs::new_builder().input_type(Some(Bytes::from(payload)).pack()).build().as_bytes()];
+    let mut variants = Vec::new();
+    for enabled in [false, true] {
+        let asm = String::from_utf8(generator(enabled).generate(&ir, ArtifactFormat::RiscvAssembly).unwrap()).unwrap();
+        let generated = generator(enabled).generate_with_evidence(&ir, ArtifactFormat::RiscvElf).unwrap();
+        let elf = crate::strip_vm_abi_trailer(&generated.bytes);
+        let (oracle, trace) = ckb_script_runner::execute_cellscript_script_with_observer(
+            elf,
+            &fixture,
+            |tx, _| tx,
+            |context, tx, script| cost_trace::measure(context, tx, script, ScriptGroupType::Type, 10_000_000),
+        );
+        assert_eq!(oracle.exit_code == 0, valid, "{name}, enabled={enabled}: {:?}", oracle.captured_debug);
+        assert_eq!(trace.status, "measured", "{name}: {:?}", trace.unavailable_reason);
+        variants.push(json!({
+            "retention":enabled,
+            "elf_hash":crate::hex_encode(&crate::ckb_blake2b256(elf)),
+            "elf_bytes":elf.len(),
+            "static_memory":cost_memory::measure(elf),
+            "entry_frame_sizes":generated.machine_layout.unwrap().entry_frame_sizes,
+            "retained_left_sites":asm.matches("# adjacent scalar: retain left").count(),
+            "retained_right_sites":asm.matches("# adjacent scalar: retain right").count(),
+            "exit":trace.exit_code,
+            "trace":trace,
+        }));
+    }
+    assert_eq!(variants[0]["exit"], variants[1]["exit"], "{name}: exact rejection must be preserved");
+    assert_eq!(variants[0]["entry_frame_sizes"], variants[1]["entry_frame_sizes"], "{name}: stack layout must be unchanged");
+    assert_eq!(
+        variants[0]["static_memory"]["store_instruction_count"], variants[1]["static_memory"]["store_instruction_count"],
+        "{name}: this experiment must retain all stack stores"
+    );
+    json!({"case":name,"source":source,"ir_mutation":ir_mutation,"valid":valid,"variants":variants})
+}
+
+#[test]
+fn adjacent_scalar_retention_preserves_operand_order_control_flow_and_calls() {
+    use crate::EntryWitnessArg::U64;
+    let mut rows = Vec::new();
+    for (name, expression, a, b, expected) in [
+        ("subtract", "a - (b + 1)", 17, 5, 11),
+        ("divide", "a / (b + 1)", 17, 5, 2),
+        ("remainder", "a % (b + 1)", 17, 5, 5),
+        ("shift", "a >> (b + 1)", 0x100, 3, 16),
+        ("nested-right", "a - (b * 3)", 17, 5, 2),
+        ("left-constant-right", "(a + b) & 255", 250, 10, 4),
+        ("overlapping", "(a + b) * (a - b)", 17, 5, 264),
+    ] {
+        for valid in [true, false] {
+            let source = action(&format!("let result = {expression}\nrequire result == expected"));
+            let row = probe(name, &source, &[U64(a), U64(b), U64(expected + u64::from(!valid))], valid);
+            assert!(
+                row["variants"][1]["retained_left_sites"].as_u64().unwrap()
+                    + row["variants"][1]["retained_right_sites"].as_u64().unwrap()
+                    > 0,
+                "{name}: the intended optimization was not exercised"
+            );
+            rows.push(row);
+        }
+    }
+    for expression in ["a / (b + 1)", "a % (b + 1)", "a << (b + 1)"] {
+        let source = action(&format!("let result = {expression}\nrequire result == expected"));
+        rows.push(probe(
+            expression,
+            &source,
+            &[U64(17), U64(if expression == "a << (b + 1)" { 63 } else { u64::MAX }), U64(0)],
+            false,
+        ));
+    }
+    for (name, expression, expected) in [("signed-divide", "a / (b + 1)", -3), ("signed-remainder", "a % (b + 1)", -2)] {
+        use crate::EntryWitnessArg::I32;
+        let source = action(&format!("let result = {expression}\nrequire result == expected")).replace(": u64", ": i32");
+        for valid in [true, false] {
+            rows.push(probe(name, &source, &[I32(-17), I32(4), I32(expected + i32::from(!valid))], valid));
+        }
+    }
+    let source = action("let result = (a + b) + b\nrequire result == expected").replace(": u64", ": u8");
+    for valid in [true, false] {
+        use crate::EntryWitnessArg::U8;
+        rows.push(probe("narrow-normalization", &source, &[U8(250), U8(10), U8(if valid { 14 } else { 15 })], valid));
+    }
+    let source = action("let mut total = a\nfor i in 0..8 { if i < 4 { total += b } else { total += 1 } }\nrequire total == expected");
+    for valid in [true, false] {
+        rows.push(probe("joins-backedges", &source, &[U64(1), U64(3), U64(if valid { 17 } else { 18 })], valid));
+    }
+    let source = action("let result = (a + b) - perturb(b)\nrequire result == expected")
+        .replace("action verify", "fn perturb(x: u64) -> u64 { let y = x + 11\nreturn y }\naction verify");
+    for valid in [true, false] {
+        rows.push(probe("call-clobber", &source, &[U64(17), U64(5), U64(if valid { 6 } else { 7 })], valid));
+    }
+    let source = action("let result = leaf(a,b,a,b,a,b,a,b,a)\nrequire result == expected").replace(
+        "action verify",
+        "fn leaf(a:u64,b:u64,c:u64,d:u64,e:u64,f:u64,g:u64,h:u64,i:u64)->u64 { let y = (a+b)-(h+i)\nreturn y }\naction verify",
+    );
+    for valid in [true, false] {
+        rows.push(probe("outgoing-nine-arguments", &source, &[U64(17), U64(5), U64(u64::from(!valid))], valid));
+    }
+    let source = action("let value = a - (b - 1)\nrequire value == expected");
+    for valid in [true, false] {
+        rows.push(probe("duplicate-ssa-operands", &source, &[U64(17), U64(5), U64(u64::from(!valid))], valid));
+    }
+    let source = action("let value = a - b\nrequire value == expected")
+        .replace("witness expected: u64", "witness expected: u64, witness marker: Hash");
+    for valid in [true, false] {
+        let row = probe(
+            "wide-parameter-fallback",
+            &source,
+            &[U64(17), U64(5), U64(if valid { 12 } else { 13 }), crate::EntryWitnessArg::Hash([0; 32])],
+            valid,
+        );
+        assert_eq!(row["variants"][0]["elf_hash"], row["variants"][1]["elf_hash"], "excluded function must stay byte-identical");
+        rows.push(row);
+    }
+    let mut body = String::new();
+    let mut level = Vec::new();
+    for index in 0..260 {
+        body.push_str(&format!("let v{index} = a + {index}\n"));
+        level.push(format!("v{index}"));
+    }
+    let mut depth = 0;
+    while level.len() > 1 {
+        level = level
+            .chunks(2)
+            .enumerate()
+            .map(|(index, pair)| {
+                if pair.len() == 1 {
+                    return pair[0].clone();
+                }
+                let name = format!("sum{depth}_{index}");
+                body.push_str(&format!("let {name} = {} + {}\n", pair[0], pair[1]));
+                name
+            })
+            .collect();
+        depth += 1;
+    }
+    body.push_str(&format!("require {} == expected", level[0]));
+    for valid in [true, false] {
+        let row = probe("large-overlapping-frame", &action(&body), &[U64(2), U64(0), U64(if valid { 34190 } else { 34191 })], valid);
+        assert!(row["variants"][0]["entry_frame_sizes"].as_object().unwrap().values().any(|size| size.as_u64().unwrap() > 2048));
+        rows.push(row);
+    }
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
+    let path = root.join("target/cellscript-cost/adjacent-scalar-retention-second.json");
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, serde_json::to_vec_pretty(&json!({
+        "schema":"cellscript-adjacent-scalar-retention-experiment-v2",
+        "scope":"identical typed IR and codegen options; test-only emitter toggle; complete compiler/checker acceptance still required",
+        "source":cost_provenance::capture_source(root),
+        "vm_configuration":cost_provenance::vm_configuration(),
+        "static_stack_scope":"per-entry frame sizes, not a call-chain bound; observed per-VM peaks are in trace",
+        "rows":rows,
+    })).unwrap()).unwrap();
+}
