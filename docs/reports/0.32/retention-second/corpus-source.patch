+    let dest = match instruction {
+        IrInstruction::LoadConst { dest, value } if scalar_constant(value) => dest,
+        IrInstruction::LoadVar { dest, .. } => dest,
+        IrInstruction::Binary { dest, left, right, .. } if scalar_operand(left) && scalar_operand(right) => dest,
