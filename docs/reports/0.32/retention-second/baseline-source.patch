+    inspect(&baseline).unwrap();
+    for nested in [false, true] {
+        let mut changed = baseline.clone();
+        if nested {
+            changed.metadata["public_interface"]["types"][0]["fields"][0]["unrecognized"] = true.into();
+        } else {
