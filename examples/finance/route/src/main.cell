module finance_route;

use finance_layouts::{
    AssetData,
    PoolState
};

private const EXACT_INPUT: u64 = 0;

private const EXACT_OUTPUT: u64 = 1;

private const RETURN_TO_AUTHORIZER: u64 = 2;

private const FIRST_POOL_STATE: u64 = 0;

private const SECOND_POOL_STATE: u64 = 3;

private const FIRST_POOL_Y_RESERVE: u64 = 2;

private const SECOND_POOL_Y_RESERVE: u64 = 4;
// A finite application intent, independent of orders and allocation tables.
public resource RouteIntent has store {
    pool_a: Hash,
    controller_a: Hash,
    pool_b: Hash,
    controller_b: Hash,
    asset_x: Hash,
    asset_y: Hash,
    asset_z: Hash,
    authorizer: Hash,
    maximum_input_x: u128,
    minimum_output_z: u128,
    exact_output_z: u128,
    maximum_fee: u64,
    maximum_capacity_debit: u64,
    nonce: u64,
}
// 0 exact input; 1 exact output; 2 authorizer unwrap. The pool Scripts
// independently check pricing; this Lock binds actual final flows and limits.
public lock verify(witness mode: u64, witness intent_index: u64, witness authorizer_index: u64) -> bool {
    check_route(mode, intent_index, authorizer_index)
}

private fn ceiling(numerator: u128, denominator: u128) -> u128 {
    let quotient = numerator / denominator;
    if (numerator % denominator == 0) {
        return quotient;
    }
    return quotient + 1;
}

private fn input_capacity(owner: Hash) -> u128 {
    let mut total: u128 = 0;
    let mut index = 0;
    while index < ckb::cell_count(source::input(0)) {
        let cell = source::input(index);
        if ckb::cell_lock_hash(cell) == owner {
            total = total + ckb::cell_capacity(cell) as u128;
        }
        index = index + 1;
    }
    return total;
}

private fn input_assets(owner: Hash, asset: Hash) -> u128 {
    let mut total: u128 = 0;
    let mut index = 0;
    while index < ckb::cell_count(source::input(0)) {
        let cell = source::input(index);
        if (ckb::cell_lock_hash(cell) == owner) && ckb::cell_has_type(cell) {
            if ckb::cell_type_hash(cell) == asset {
                if ckb::cell_data_size(cell) != 16 {
                    return 32000000000001;
                }
                let amount = ckb::input::<AssetData>(index).data.amount;
                if amount > 1000000000000 {
                    return 32000000000001;
                }
                total = total + amount;
            }
        }
        index = index + 1;
    }
    return total;
}

private fn output_capacity(owner: Hash) -> u128 {
    let mut total: u128 = 0;
    let mut index = 0;
    while index < ckb::cell_count(source::output(0)) {
        let cell = source::output(index);
        if ckb::cell_lock_hash(cell) == owner {
            total = total + ckb::cell_capacity(cell) as u128;
        }
        index = index + 1;
    }
    return total;
}

private fn output_assets(owner: Hash, asset: Hash) -> u128 {
    let mut total: u128 = 0;
    let mut index = 0;
    while index < ckb::cell_count(source::output(0)) {
        let cell = source::output(index);
        if (ckb::cell_lock_hash(cell) == owner) && ckb::cell_has_type(cell) {
            if ckb::cell_type_hash(cell) == asset {
                if ckb::cell_data_size(cell) != 16 {
                    return 32000000000001;
                }
                let amount = ckb::output::<AssetData>(index).data.amount;
                if amount > 1000000000000 {
                    return 32000000000001;
                }
                total = total + amount;
            }
        }
        index = index + 1;
    }
    return total;
}

private fn check_route_pool(index: u64, identity: Hash, controller: Hash, first: Hash, second: Hash) -> bool {
    let old = source::input(index);
    let next = source::output(index);
    if (ckb::cell_data_size(old) != 264) || (ckb::cell_data_size(next) != 264) {
        return false;
    }
    ckb::require_cell_type_hash(old, identity);
    ckb::require_cell_type_hash(next, identity);
    ckb::require_cell_lock_hash(old, controller);
    ckb::require_cell_lock_hash(next, controller);
    let current = ckb::input::<PoolState>(index).data;
    let successor = ckb::output::<PoolState>(index).data;
    if (current.asset_a != first) || (current.asset_b != second) {
        return false;
    }
    if (successor.asset_a != first) || (successor.asset_b != second) {
        return false;
    }
    if (current.total_lp > 1000000000000) || (current.total_lp != successor.total_lp) {
        return false;
    }
    let mut i = 0;
    let mut before = 0;
    let mut after = 0;
    while (i < ckb::cell_count(source::input(0))) {
        let cell = source::input(i);
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == identity) {
                before = before + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < ckb::cell_count(source::output(0))) {
        let cell = source::output(i);
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == identity) {
                after = after + 1;
            }
        }
        i = i + 1;
    }
    return (before == 1) && (after == 1);
}

private fn check_route(mode: u64, intent_index: u64, authorizer_index: u64) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (mode > RETURN_TO_AUTHORIZER) || (inputs > 32) || (outputs > 32) || (intent_index >= inputs) || (authorizer_index >= inputs) {
        return false;
    }
    let controller = ckb::cell_lock_hash(source::group_input(0));
    let intent = source::input(intent_index);
    if ckb::cell_has_type(intent) || (ckb::cell_data_size(intent) != 328) {
        return false;
    }
    ckb::require_cell_lock_hash(intent, controller);
    ckb::require_cell_lock_args32(intent, ckb::cell_data_hash_field(intent).0);
    let terms = ckb::input::<RouteIntent>(intent_index).data;
    if terms.nonce > 1000000 {
        return false;
    }
    let pool_a = terms.pool_a;
    let controller_a = terms.controller_a;
    let pool_b = terms.pool_b;
    let controller_b = terms.controller_b;
    let x = terms.asset_x;
    let y = terms.asset_y;
    let z = terms.asset_z;
    let authorizer = terms.authorizer;
    if (pool_a == pool_b) || (x == y) || (y == z) || (x == z) || (authorizer == controller) {
        return false;
    }
    let maximum_input = terms.maximum_input_x;
    let minimum_output = terms.minimum_output_z;
    let exact_output = terms.exact_output_z;
    if (maximum_input == 0) || (maximum_input > 1000000000000) || (minimum_output == 0) || (minimum_output > 1000000000000) || (exact_output > 1000000000000) {
        return false;
    }
    let maximum_fee = terms.maximum_fee as u128;
    let maximum_capacity = terms.maximum_capacity_debit as u128;
    let authority = source::input(authorizer_index);
    ckb::require_cell_lock_hash(authority, authorizer);
    // Exact bundled ckb-system-scripts v0.6.0 executable identity, data2.
    ckb::require_cell_lock_script_hash_type(authority, Hash::from_bytes(b"\x70\x9f\x3f\xda\x12\xf5\x61\xcf\xac\xf9\x22\x73\xc5\x7a\x98\xfe\xde\x18\x8a\x3f\x1a\x59\xb1\xf8\x88\xd1\x13\xf9\xcc\xe0\x86\x49"),
    4);
    if ckb::cell_has_type(authority) || (ckb::cell_data_size(authority) != 0) {
        return false;
    }
    let mut before_capacity: u128 = 0;
    let mut after_capacity: u128 = 0;
    let mut descriptors = 0;
    let mut retained = 0;
    let mut i = 0;
    while (i < inputs) {
        let cell = source::input(i);
        before_capacity = before_capacity + ckb::cell_capacity(cell) as u128;
        let owner = ckb::cell_lock_hash(cell);
        if (owner == authorizer) && (ckb::cell_has_type(cell) || (ckb::cell_data_size(cell) != 0)) {
            return false;
        }
        if (owner == controller) {
            if ckb::cell_has_type(cell) {
                let asset = ckb::cell_type_hash(cell);
                if (asset != x) && (asset != z) {
                    return false;
                }
            } else if (ckb::cell_data_size(cell) == 328) {
                if (ckb::cell_data_hash_field(cell) != ckb::cell_data_hash_field(intent)) {
                    return false;
                }
                descriptors = descriptors + 1;
            } else if (ckb::cell_data_size(cell) != 0) {
                return false;
            }
        }
        if (mode != RETURN_TO_AUTHORIZER) && ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == y) && (i != FIRST_POOL_Y_RESERVE) && (i != SECOND_POOL_Y_RESERVE) {
                return false;
            }
        }
        i = i + 1;
    }
    while (i - inputs < outputs) {
        let index = i - inputs;
        let cell = source::output(index);
        after_capacity = after_capacity + ckb::cell_capacity(cell) as u128;
        if (ckb::cell_lock_hash(cell) == authorizer) {
            if ckb::cell_has_type(cell) {
                let asset = ckb::cell_type_hash(cell);
                if (asset != x) && (asset != z) {
                    return false;
                }
                if (ckb::cell_data_size(cell) != 16) || (ckb::output::<AssetData>(index).data.amount > 1000000000000) {
                    return false;
                }
            } else if (ckb::cell_data_size(cell) != 0) {
                return false;
            }
        }
        if (ckb::cell_lock_hash(cell) == controller) {
            if ckb::cell_has_type(cell) {
                let asset = ckb::cell_type_hash(cell);
                if (asset != x) && (asset != z) {
                    return false;
                }
            } else if (ckb::cell_data_size(cell) == 328) {
                if (ckb::cell_data_hash_field(cell) != ckb::cell_data_hash_field(intent)) {
                    return false;
                }
                retained = retained + 1;
            } else if (ckb::cell_data_size(cell) != 0) {
                return false;
            }
        }
        if (mode != RETURN_TO_AUTHORIZER) && ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == y) && (index != FIRST_POOL_Y_RESERVE) && (index != SECOND_POOL_Y_RESERVE) {
                return false;
            }
        }
        i = i + 1;
    }
    if (descriptors != 1) || (after_capacity > before_capacity) || (before_capacity - after_capacity > maximum_fee) {
        return false;
    }
    let before_x = input_assets(controller, x);
    let before_z = input_assets(controller, z);
    if (before_x > 32000000000000) || (before_z > 32000000000000) {
        return false;
    }
    if (mode == RETURN_TO_AUTHORIZER) {
        i = 0;
        while (i < outputs) {
            if (ckb::cell_lock_hash(source::output(i)) == controller) {
                return false;
            }
            i = i + 1;
        }
        let refunded_x = output_assets(authorizer, x);
        let refunded_z = output_assets(authorizer, z);
        if (refunded_x > 32000000000000) || (refunded_z > 32000000000000) {
            return false;
        }
        if (refunded_x < before_x) || (refunded_z < before_z) {
            return false;
        }
        return (output_capacity(authorizer) + (before_capacity - after_capacity) >= input_capacity(controller) + input_capacity(authorizer));
    }
    // Fixed prefix, unrelated non-Y Cells may follow. No fresh output is used
    // as an input: intermediate Y is netted between authentic reserve deltas.
    if (inputs < 10) || (outputs < 11) || (intent_index != 8) || (authorizer_index != 9) {
        return false;
    }
    if (retained != 1) || (ckb::cell_count(source::group_input(0)) != 3) {
        return false;
    }
    if !check_route_pool(FIRST_POOL_STATE, pool_a, controller_a, x, y) || !check_route_pool(SECOND_POOL_STATE,
    pool_b, controller_b, y, z) {
        return false;
    }
    let trader_asset = source::input(6);
    let trader_funding = source::input(7);
    let input_asset_change = source::output(6);
    let final_asset_credit = source::output(7);
    let capacity_change = source::output(8);
    ckb::require_cell_lock_hash(trader_asset, controller);
    ckb::require_cell_type_hash(trader_asset, x);
    ckb::require_cell_lock_hash(trader_funding, controller);
    if ckb::cell_has_type(trader_funding) || (ckb::cell_data_size(trader_funding) != 0) {
        return false;
    }
    ckb::require_cell_lock_hash(input_asset_change, controller);
    ckb::require_cell_type_hash(input_asset_change, x);
    ckb::require_cell_lock_hash(final_asset_credit, controller);
    ckb::require_cell_type_hash(final_asset_credit, z);
    ckb::require_cell_lock_hash(capacity_change, controller);
    if ckb::cell_has_type(capacity_change) || (ckb::cell_data_size(capacity_change) != 0) {
        return false;
    }
    let next_intent = source::output(9);
    ckb::require_cell_lock_hash(next_intent, controller);
    if ckb::cell_has_type(next_intent) || (ckb::cell_data_hash_field(next_intent) != ckb::cell_data_hash_field(intent)) || (ckb::cell_capacity(next_intent) != ckb::cell_capacity(intent)) {
        return false;
    }
    let refund = source::output(10);
    ckb::require_cell_lock_hash(refund, authorizer);
    if ckb::cell_has_type(refund) || (ckb::cell_data_size(refund) != 0) {
        return false;
    }
    let first_before = ckb::input::<PoolState>(FIRST_POOL_STATE).data;
    let first_after = ckb::output::<PoolState>(FIRST_POOL_STATE).data;
    let second_before = ckb::input::<PoolState>(SECOND_POOL_STATE).data;
    let second_after = ckb::output::<PoolState>(SECOND_POOL_STATE).data;
    let old_x = first_before.reserve_a;
    let next_x = first_after.reserve_a;
    let old_y_a = first_before.reserve_b;
    let next_y_a = first_after.reserve_b;
    let old_y_b = second_before.reserve_a;
    let next_y_b = second_after.reserve_a;
    let old_z = second_before.reserve_b;
    let next_z = second_after.reserve_b;
    if (old_x > 1000000000000) || (next_x > 1000000000000) || (old_y_a > 1000000000000) || (next_y_a > 1000000000000) || (old_y_b > 1000000000000) || (next_y_b > 1000000000000) || (old_z > 1000000000000) || (next_z > 1000000000000) {
        return false;
    }
    if (next_x <= old_x) || (next_y_a >= old_y_a) || (next_y_b <= old_y_b) || (next_z >= old_z) {
        return false;
    }
    let spent = next_x - old_x;
    let received = old_z - next_z;
    if (old_y_a - next_y_a != next_y_b - old_y_b) || (spent > maximum_input) || (received < minimum_output) {
        return false;
    }
    if (mode == EXACT_INPUT) && ((exact_output != 0) || (spent != maximum_input)) {
        return false;
    }
    if (mode == EXACT_OUTPUT) && ((exact_output == 0) || (received != exact_output)) {
        return false;
    }
    // Bind economic amount modes independently of the peer entry witnesses.
    // A ceiling-priced leg must not replace an exact-input floor result, nor
    // may an exact-output leg consume extra units with the same floor quote.
    let fee_a = first_before.fee;
    let fee_b = second_before.fee;
    if (fee_a > 1000) || (fee_b > 1000) || (next_y_a == 0) || (next_z == 0) {
        return false;
    }
    let middle = old_y_a - next_y_a;
    if (mode == EXACT_INPUT) {
        let scaled_a = spent * (10000 - fee_a) as u128;
        let scaled_b = middle * (10000 - fee_b) as u128;
        if (middle != old_y_a * scaled_a / (old_x * 10000 + scaled_a)) {
            return false;
        }
        if (received != old_z * scaled_b / (old_y_b * 10000 + scaled_b)) {
            return false;
        }
    } else {
        if (middle != ceiling(old_y_b * received * 10000, next_z * (10000 - fee_b) as u128)) {
            return false;
        }
        if (spent != ceiling(old_x * middle * 10000, next_y_a * (10000 - fee_a) as u128)) {
            return false;
        }
    }
    let after_x = output_assets(controller, x);
    let after_z = output_assets(controller, z);
    if (after_x > 32000000000000) || (after_z > 32000000000000) {
        return false;
    }
    if (before_x != after_x + spent) || (before_z + received != after_z) {
        return false;
    }
    if (output_capacity(authorizer) < input_capacity(authorizer)) {
        return false;
    }
    return (output_capacity(controller) + maximum_capacity >= input_capacity(controller));
}
