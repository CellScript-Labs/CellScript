module finance_escrow

public resource EscrowData has store {
    amount: u128,
    order: Hash,
    controller: Hash,
    asset: Hash,
}

public lock verify() -> bool {
    verification
        check_escrow()
}

private fn check_escrow() -> bool {
    if ckb::cell_count(source::group_input(0)) != 1 { return false }
    let inputs = ckb::cell_count(source::input(0))
    let outputs = ckb::cell_count(source::output(0))
    if inputs > 32 || outputs > 32 { return false }
    let escrow = source::group_input(0)
    if ckb::cell_data_size(escrow) != 112 { return false }
    let data = ckb::group_input<EscrowData>(0).data
    if data.amount > 1000000000000 { return false }
    ckb::require_cell_lock_args32(escrow, ckb::cell_data_blake2b_span(escrow, 16, 96).0)
    let order = data.order
    let controller = data.controller
    let asset = data.asset
    ckb::require_cell_type_hash(escrow, asset)
    let mut found_input = 0
    let mut found_output = 0
    let mut i = 0
    while i < inputs {
        let cell = source::input(i)
        if ckb::cell_has_type(cell) {
            if ckb::cell_type_hash(cell) == order {
                if ckb::cell_lock_hash(cell) != controller { return false }
                found_input = found_input + 1
            }
        }
        i = i + 1
    }
    i = 0
    while i < outputs {
        let cell = source::output(i)
        if ckb::cell_has_type(cell) {
            if ckb::cell_type_hash(cell) == order {
                if ckb::cell_lock_hash(cell) != controller { return false }
                found_output = found_output + 1
            }
        }
        i = i + 1
    }
    // The actual order Lock executes on the unique input and validates either
    // the one authentic remainder or its terminal fill/cancellation outputs.
    return found_input == 1 && found_output <= 1
}
