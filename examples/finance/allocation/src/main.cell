module finance_allocation;

use finance_layouts::{
    AssetData,
    EscrowData,
    OrderState
};

use finance_deployment::{
    asset_code_hash,
    escrow_code_hash,
    network_domain
};

use finance_math::mul_div_ceil;

public struct CreditRow has fixed, serializable {
    order: Hash,
    output_index: u64,
    amount: u128,
}

private const EXECUTE: u64 = 0;

private const RETURN_TO_AUTHORIZER: u64 = 1;

private const MAX_CREDITS: u64 = 4;

private const MAX_AMOUNT: u128 = 1000000000000;
// The complete, fixed allocation table is actual input 0. Every participant
// reads the same Cell, whose full data hash is committed by this Lock's args.
public resource AllocationData has store {
    authorizer: Hash,
    allowed_order_code: Hash,
    network: Hash,
    auth_input: u64,
    change_output: u64,
    order_count: u64,
    credit_count: u64,
    order0: Hash,
    order1: Hash,
    credits: [CreditRow; 4],
}
// operation 0 executes the committed plan; operation 1 returns every controlled
// Cell unchanged to the real authorizer after a stale or abandoned plan.
public lock verify(witness operation: u64, witness auth_index: u64) -> bool {
    check_allocation_lock(operation, auth_index)
}

private fn check_allocation_lock(operation: u64, auth_index: u64) -> bool {
    if (ckb::cell_count(source::input(0)) == 0) {
        return false;
    }
    if (ckb::cell_lock_hash(source::input(0)) != ckb::current_script_hash()) {
        return false;
    }
    if (ckb::cell_data_size(source::input(0)) != 416) {
        return false;
    }
    ckb::require_cell_lock_args32(source::input(0), ckb::cell_data_hash_field(source::input(0)).0);
    let table = ckb::input::<AllocationData>(0).data;
    if table.network != network_domain() {
        return false;
    }
    if (operation == RETURN_TO_AUTHORIZER) {
        return return_controlled_cells(auth_index);
    }
    if (operation != EXECUTE) || (auth_index != table.auth_input) {
        return false;
    }
    let order_code = table.allowed_order_code;
    if !verify_table(order_code) {
        return false;
    }
    return participant_states(order_code);
}
// This profile pins the actual repo upstream secp256k1-blake160-sighash-all
// executable used in its all-group VM evidence, data2 and exactly 20 args bytes.
// It is a code identity, not a claim of public-network deployment.
private fn authorizer_code_hash() -> Hash {
    return Hash::from_bytes(b"\x70\x9f\x3f\xda\x12\xf5\x61\xcf\xac\xf9\x22\x73\xc5\x7a\x98\xfe\xde\x18\x8a\x3f\x1a\x59\xb1\xf8\x88\xd1\x13\xf9\xcc\xe0\x86\x49");
}

private fn real_authorizer_at(index: u64) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    if (index == 0) || (index >= inputs) {
        return false;
    }
    let expected = ckb::input::<AllocationData>(0).data.authorizer;
    let auth = source::input(index);
    ckb::require_cell_lock_hash(auth, expected);
    ckb::require_cell_lock_script_hash_type(auth, authorizer_code_hash(), 4);
    return (ckb::cell_lock_size(auth) == 73);
}

private fn check_authorizer() -> bool {
    let descriptor = source::input(0);
    let outputs = ckb::cell_count(source::output(0));
    let table = ckb::input::<AllocationData>(0).data;
    let index = table.auth_input;
    let change = table.change_output;
    if (change >= outputs) || !real_authorizer_at(index) {
        return false;
    }
    let refund = source::output(change);
    if ckb::cell_has_type(refund) || (ckb::cell_data_size(refund) != 0) {
        return false;
    }
    ckb::require_cell_lock_hash(refund, table.authorizer);
    return (ckb::cell_capacity(refund) >= ckb::cell_capacity(descriptor));
}

private fn return_controlled_cells(auth_index: u64) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (inputs > 32) || (outputs > 32) || !real_authorizer_at(auth_index) {
        return false;
    }
    let count = ckb::cell_count(source::group_input(0));
    if (count == 0) || (count > outputs) {
        return false;
    }
    let authorizer = ckb::input::<AllocationData>(0).data.authorizer;
    let mut i = 0;
    while (i < count) {
        let before = source::group_input(i);
        let after = source::output(i);
        ckb::require_cell_lock_hash(after, authorizer);
        if (ckb::cell_capacity(before) != ckb::cell_capacity(after)) {
            return false;
        }
        if (ckb::cell_data_size(before) != ckb::cell_data_size(after)) {
            return false;
        }
        if (ckb::cell_data_hash_field(before) != ckb::cell_data_hash_field(after)) {
            return false;
        }
        if (ckb::cell_has_type(before) != ckb::cell_has_type(after)) {
            return false;
        }
        if ckb::cell_has_type(before) {
            ckb::require_cell_type_hash(after, ckb::cell_type_hash(before))
        }
        i = i + 1;
    }
    return true;
}

public fn credited_amount(order: Hash) -> u128 {
    let table = ckb::input::<AllocationData>(0).data;
    let count = table.credit_count;
    if count > MAX_CREDITS {
        return MAX_AMOUNT + 1;
    }
    let credits = table.credits;
    let mut total: u128 = 0;
    let mut row = 0;
    while row < count {
        let credit = credits[row];
        if credit.order == order {
            if credit.amount > MAX_AMOUNT {
                return MAX_AMOUNT + 1;
            }
            total = total + credit.amount;
        }
        row = row + 1;
    }
    return total;
}

private fn input_escrow(index: u64, order: Hash, controller: Hash, asset: Hash, amount: u128) -> bool {
    let cell = source::input(index);
    if ckb::cell_data_size(cell) != 112 {
        return false;
    }
    let escrow = ckb::input::<EscrowData>(index).data;
    if escrow.amount != amount {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, escrow_code_hash(), 4);
    if (escrow.order != order) {
        return false;
    }
    if (escrow.controller != controller) {
        return false;
    }
    if (escrow.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn output_escrow(index: u64, order: Hash, controller: Hash, asset: Hash, amount: u128) -> bool {
    let cell = source::output(index);
    if ckb::cell_data_size(cell) != 112 {
        return false;
    }
    let escrow = ckb::output::<EscrowData>(index).data;
    if escrow.amount != amount {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, escrow_code_hash(), 4);
    if (escrow.order != order) {
        return false;
    }
    if (escrow.controller != controller) {
        return false;
    }
    if (escrow.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn participant(index: u64, order: Hash) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (index + 1 >= inputs) {
        return false;
    }
    let before = source::input(index);
    ckb::require_cell_type_script_hash_type(before, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    let identity_args = ckb::cell_type_args32(before);
    ckb::require_cell_type_args32(before, identity_args);
    let controller = ckb::cell_lock_hash(before);
    let configuration = ckb::cell_data_blake2b_span(before, 0, 280);
    ckb::require_cell_lock_args32(before, configuration.0);
    let state = ckb::input::<OrderState>(index).data;
    let asset = state.sold_asset;
    let numerator = state.numerator;
    let denominator = state.denominator;
    let total = state.total_sold;
    let filled = state.filled;
    let entitlement = state.entitlement;
    if (numerator == 0) || (denominator == 0) || (total == 0) || (filled >= total) {
        return false;
    }
    if (numerator > MAX_AMOUNT) || (denominator > MAX_AMOUNT) || (total > MAX_AMOUNT) || (entitlement > MAX_AMOUNT) {
        return false;
    }
    if (entitlement != mul_div_ceil(filled, numerator, denominator)) {
        return false;
    }
    if (mul_div_ceil(total, numerator, denominator) > MAX_AMOUNT) {
        return false;
    }
    if !input_escrow(index + 1, order, controller, asset, total - filled) {
        return false;
    }
    let old_index = ckb::input_out_point_index(before) as u64;
    if (old_index == 4294967295) {
        return false;
    }
    ckb::require_input_out_point(source::input(index + 1), ckb::input_out_point_tx_hash(before), old_index + 1);
    let mut found = 0;
    let mut i = 0;
    let mut next_filled: u128 = 0;
    let mut next_entitlement: u128 = 0;
    while (i < outputs) {
        let after = source::output(i);
        if ckb::cell_has_type(after) {
            if (ckb::cell_type_hash(after) == order) {
                if (i + 1 >= outputs) || (ckb::cell_data_size(after) != 320) {
                    return false;
                }
                ckb::require_cell_lock_hash(after, controller);
                if (ckb::cell_data_blake2b_span(after, 0, 280) != configuration) {
                    return false;
                }
                let next = ckb::output::<OrderState>(i).data;
                next_filled = next.filled;
                next_entitlement = next.entitlement;
                if (next_filled <= filled) || (next_filled >= total) || (next_entitlement > MAX_AMOUNT) {
                    return false;
                }
                if (next_entitlement != mul_div_ceil(next_filled, numerator, denominator)) {
                    return false;
                }
                let revision = state.revision;
                if (revision == 18446744073709551615) || (next.revision != revision + 1) {
                    return false;
                }
                if (ckb::cell_capacity(before) != ckb::cell_capacity(after)) {
                    return false;
                }
                if !output_escrow(i + 1, order, controller, asset, total - next_filled) {
                    return false;
                }
                if (ckb::cell_capacity(source::input(index + 1)) != ckb::cell_capacity(source::output(i + 1))) {
                    return false;
                }
                found = found + 1;
            }
        }
        i = i + 1;
    }
    if (found != 1) || (next_entitlement <= entitlement) {
        return false;
    }
    let credited = credited_amount(order);
    return (credited <= MAX_AMOUNT) && (credited >= next_entitlement - entitlement);
}

private fn valid_rows(first: u64, second: u64, first_order: Hash, second_order: Hash, count: u64, credit_count: u64) -> bool {
    let credits = ckb::input::<AllocationData>(0).data.credits;
    let outputs = ckb::cell_count(source::output(0));
    let mut previous_order = 0;
    let mut previous_output = 0;
    let mut row = 0;
    while row < MAX_CREDITS {
        let credit = credits[row];
        let order = credit.order;
        let output_index = credit.output_index;
        let amount = credit.amount;
        if row >= credit_count {
            if (order != Hash::zero()) || (output_index != 0) || (amount != 0) {
                return false;
            }
        } else {
            if (amount == 0) || (amount > MAX_AMOUNT) || (output_index >= outputs) {
                return false;
            }
            let mut ordinal = 0;
            let mut input_index = first;
            if (order != first_order) {
                if (count != 2) || (order != second_order) {
                    return false;
                }
                ordinal = 1;
                input_index = second;
            }
            if (row > 0) && ((ordinal < previous_order) || ((ordinal == previous_order) && (output_index <= previous_output))) {
                return false;
            }
            previous_order = ordinal;
            previous_output = output_index;
            let state = ckb::input::<OrderState>(input_index).data;
            let payment = source::output(output_index);
            if ckb::cell_data_size(payment) != 16 {
                return false;
            }
            let paid = ckb::output::<AssetData>(output_index).data.amount;
            if paid > MAX_AMOUNT {
                return false;
            }
            ckb::require_cell_type_hash(payment, state.requested_asset);
            ckb::require_cell_type_script_hash_type(payment, asset_code_hash(), 4);
            ckb::require_cell_lock_hash(payment, state.proceeds);
            let issuer = ckb::cell_type_args32(payment);
            ckb::require_cell_type_args32(payment, issuer);
            // Sum every row crediting this actual global output. Repeated
            // references from different obligations do not reset its budget.
            let mut aggregate: u128 = 0;
            let mut other = 0;
            while other < credit_count {
                let other_credit = credits[other];
                if other_credit.output_index == output_index {
                    if other_credit.amount > MAX_AMOUNT {
                        return false;
                    }
                    aggregate = aggregate + other_credit.amount;
                }
                other = other + 1;
            }
            if aggregate > paid {
                return false;
            }
        }
        row = row + 1;
    }
    return true;
}

private fn participant_states(expected_order_code: Hash) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let mut index = 1;
    while (index < inputs) {
        let state = source::input(index);
        if (ckb::cell_lock_code_hash(state) == expected_order_code) && (ckb::cell_lock_hash_type(state) == 4) {
            if !participant(index, ckb::cell_type_hash(state)) {
                return false;
            }
        }
        index = index + 1;
    }
    return true;
}

private fn check_participant_identity(index: u64, expected_order: Hash) -> bool {
    let state = source::input(index);
    if (ckb::cell_data_size(state) != 320) || !ckb::cell_has_type(state) {
        return false;
    }
    ckb::require_cell_type_script_hash_type(state, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    let identity_args = ckb::cell_type_args32(state);
    ckb::require_cell_type_args32(state, identity_args);
    ckb::require_cell_lock_args32(state, ckb::cell_data_blake2b_span(state, 0, 280).0);
    return (ckb::cell_type_hash(state) == expected_order) && (ckb::input::<OrderState>(index).data.order == expected_order);
}

private fn check_participant_set(inputs: u64, expected_order_code: Hash, first_order: Hash, second_order: Hash,
count: u64, credits: u64) -> bool {
    let mut found = 0;
    let mut first = 0;
    let mut second = 0;
    let mut i = 1;
    while (i < inputs) {
        let state = source::input(i);
        if (ckb::cell_lock_code_hash(state) == expected_order_code) && (ckb::cell_lock_hash_type(state) == 4) {
            if found == 0 {
                if !check_participant_identity(i, first_order) {
                    return false;
                }
                first = i;
            } else if (found == 1) && (count == 2) {
                if !check_participant_identity(i, second_order) {
                    return false;
                }
                second = i;
            } else {
                return false;
            }
            found = found + 1;
        }
        i = i + 1;
    }
    return (found == count) && valid_rows(first, second, first_order, second_order, count, credits);
}
// Used by this allocator and by every participating Order Lock. The caller's
// actual code hash, not an untrusted name, selects the complete participant set.
public fn verify_table(expected_order_code: Hash) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (inputs == 0) || (inputs > 32) || (outputs > 32) {
        return false;
    }
    let descriptor = source::input(0);
    if ckb::cell_has_type(descriptor) || (ckb::cell_data_size(descriptor) != 416) {
        return false;
    }
    ckb::require_cell_lock_args32(descriptor, ckb::cell_data_hash_field(descriptor).0);
    let table = ckb::input::<AllocationData>(0).data;
    if (table.allowed_order_code != expected_order_code) || (table.network != network_domain()) {
        return false;
    }
    let count = table.order_count;
    let credits = table.credit_count;
    if (count == 0) || (count > 2) || (credits == 0) || (credits > MAX_CREDITS) {
        return false;
    }
    let first_order = table.order0;
    let second_order = table.order1;
    if (count == 1) && (second_order != Hash::zero()) {
        return false;
    }
    if (count == 2) && (first_order == second_order) {
        return false;
    }
    if !check_authorizer() {
        return false;
    }
    return check_participant_set(inputs, expected_order_code, first_order, second_order, count, credits);
}
