module finance_order;

use finance_layouts::{
    AssetData,
    EscrowData,
    OrderState
};

use finance_deployment::{
    asset_code_hash,
    escrow_code_hash,
    network_domain,
    allocation_code_hash
};

use finance_math::mul_div_ceil;

use finance_allocation::{
    verify_table,
    credited_amount
};
// The witness mode tags are part of the deployed entry ABI.
private const INITIALIZE: u64 = 0;

private const PARTIAL_FILL: u64 = 1;

private const FINAL_FILL: u64 = 2;

private const CANCEL: u64 = 3;

private const DIRECT_PARTIAL_FILL: u64 = 4;

private const DIRECT_FINAL_FILL: u64 = 5;

private const SHARED_PARTIAL_FILL: u64 = 6;
// Overpayment is a donation; cumulative entitlement follows filled volume.
public lock verify(witness mode: u64, witness input_base: u64, witness output_base: u64, witness sold: u128,
witness paid: u128, witness taker: Hash, witness requested_issuer: Hash,) -> bool {
    check_order(mode, input_base, output_base, sold, paid, taker, requested_issuer)
}

private fn requested_asset_matches(expected: Hash, issuer: Hash) -> bool {
    let requested = script::new(asset_code_hash(), 4, script::args(issuer));
    return (script::hash(requested) == ckb::script_hash(expected));
}

private fn input_asset(index: u64, asset: Hash, owner: Hash) -> bool {
    let cell = source::input(index);
    if (ckb::cell_data_size(cell) != 16) || (ckb::input::<AssetData>(index).data.amount > 1000000000000) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_type_script_hash_type(cell, asset_code_hash(), 4);
    ckb::require_cell_lock_hash(cell, owner);
    let issuer = ckb::cell_type_args32(cell);
    ckb::require_cell_type_args32(cell, issuer);
    return true;
}

private fn output_asset(index: u64, asset: Hash, owner: Hash, amount: u128) -> bool {
    let cell = source::output(index);
    if (ckb::cell_data_size(cell) != 16) || (amount > 1000000000000) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_type_script_hash_type(cell, asset_code_hash(), 4);
    ckb::require_cell_lock_hash(cell, owner);
    return (ckb::output::<AssetData>(index).data.amount == amount);
}

private fn output_change(index: u64, owner: Hash) -> bool {
    let cell = source::output(index);
    if ckb::cell_has_type(cell) || (ckb::cell_data_size(cell) != 0) {
        return false;
    }
    ckb::require_cell_lock_hash(cell, owner);
    return true;
}

private fn input_escrow(index: u64, amount: u128, order: Hash, controller: Hash, asset: Hash) -> bool {
    let cell = source::input(index);
    if (ckb::cell_data_size(cell) != 112) {
        return false;
    }
    let escrow = ckb::input::<EscrowData>(index).data;
    if escrow.amount != amount {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, escrow_code_hash(), 4);
    if (escrow.order != order) {
        return false;
    }
    if (escrow.controller != controller) {
        return false;
    }
    if (escrow.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn output_escrow(index: u64, amount: u128, order: Hash, controller: Hash, asset: Hash) -> bool {
    let cell = source::output(index);
    if (ckb::cell_data_size(cell) != 112) {
        return false;
    }
    let escrow = ckb::output::<EscrowData>(index).data;
    if escrow.amount != amount {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, escrow_code_hash(), 4);
    if (escrow.order != order) {
        return false;
    }
    if (escrow.controller != controller) {
        return false;
    }
    if (escrow.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn unique_order(order: Hash, code: Hash, expected_inputs: u64, expected_outputs: u64) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    let mut found_input = 0;
    let mut found_output = 0;
    let mut controllers = 0;
    let mut i = 0;
    while (i < inputs) {
        let cell = source::input(i);
        // Basic C1 modes admit one order controller. Shared-output modes must
        // separately authenticate their complete allocation table first.
        if (ckb::cell_lock_code_hash(cell) == code) && (ckb::cell_lock_hash_type(cell) == 4) {
            controllers = controllers + 1;
        }
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == order) {
                found_input = found_input + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < outputs) {
        let cell = source::output(i);
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == order) {
                found_output = found_output + 1;
            }
        }
        i = i + 1;
    }
    return (controllers == 1) && (found_input == expected_inputs) && (found_output == expected_outputs);
}

private struct ActiveOrder {
    identity: Hash,
    code: Hash,
    controller: Hash,
    configuration: Hash,
    sold_asset: Hash,
    requested_asset: Hash,
    maker: Hash,
    proceeds: Hash,
}

private struct Fill {
    sold: u128,
    paid: u128,
    filled: u128,
    entitlement: u128,
    remaining: u128,
}

private fn check_partial_successor(input_index: u64, output_index: u64, order: ActiveOrder, fill: Fill) -> bool {
    let before = source::input(input_index);
    let after = source::output(output_index);
    if (ckb::cell_data_size(after) != 320) || (ckb::cell_data_blake2b_span(after, 0, 280) != order.configuration) {
        return false;
    }
    ckb::require_cell_lock_hash(after, order.controller);
    ckb::require_cell_type_hash(after, order.identity);
    if ckb::cell_capacity(before) != ckb::cell_capacity(after) {
        return false;
    }
    let revision = ckb::input::<OrderState>(input_index).data.revision;
    let next = ckb::output::<OrderState>(output_index).data;
    if (revision == 18446744073709551615) || (next.revision != revision + 1) {
        return false;
    }
    if (next.filled != fill.filled) || (next.entitlement != fill.entitlement) {
        return false;
    }
    let escrow_in = input_index + 1;
    let escrow_out = output_index + 1;
    if !output_escrow(escrow_out, fill.remaining, order.identity, order.controller, order.sold_asset) {
        return false;
    }
    return ckb::cell_capacity(source::input(escrow_in)) == ckb::cell_capacity(source::output(escrow_out));
}

private fn initialize_order(order: Hash, code: Hash, controller: Hash, maker: Hash, sold_asset: Hash,
total: u128, filled: u128, entitlement: u128,) -> bool {
    let before = source::input(1);
    if ckb::cell_has_type(before) || !unique_order(order, code, 0, 1) {
        return false;
    }
    if (filled != 0) || (entitlement != 0) || (ckb::input::<OrderState>(1).data.revision != 0) {
        return false;
    }
    let after = source::output(0);
    if (ckb::cell_data_size(after) != 320) || (ckb::cell_data_hash_field(before) != ckb::cell_data_hash_field(after)) {
        return false;
    }
    ckb::require_cell_lock_hash(after, controller);
    ckb::require_cell_type_hash(after, order);
    ckb::require_cell_type_script_hash_type(after, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    if (ckb::cell_capacity(before) != ckb::cell_capacity(after)) {
        return false;
    }
    let funding = source::input(0);
    ckb::require_cell_lock_hash(funding, maker);
    if ckb::cell_has_type(funding) || (ckb::cell_data_size(funding) != 0) {
        return false;
    }
    if !input_asset(2, sold_asset, maker) {
        return false;
    }
    let provided = ckb::input::<AssetData>(2).data.amount;
    if (provided < total) || !output_escrow(1, total, order, controller, sold_asset) {
        return false;
    }
    if !output_asset(2, sold_asset, maker, provided - total) {
        return false;
    }
    if (ckb::cell_capacity(source::input(2)) != ckb::cell_capacity(source::output(2))) {
        return false;
    }
    return output_change(3, maker);
}

private fn check_shared_fill(ib: u64, ob: u64, outputs: u64, order: ActiveOrder, fill: Fill, taker: Hash) -> bool {
    if (ib == 0) || (fill.remaining == 0) || (outputs <= ob + 1) {
        return false;
    }
    let allocation = source::input(0);
    ckb::require_cell_lock_script_hash_type(allocation, allocation_code_hash(), 4);
    if (ckb::cell_data_size(allocation) != 416) {
        return false;
    }
    ckb::require_cell_lock_args32(allocation, ckb::cell_data_hash_field(allocation).0);
    if (ckb::cell_lock_hash(allocation) != taker) {
        return false;
    }
    if !verify_table(order.code) || (credited_amount(order.identity) != fill.paid) {
        return false;
    }
    return check_partial_successor(ib, ob, order, fill);
}

private fn check_direct_fill(mode: u64, ib: u64, ob: u64, outputs: u64, order: ActiveOrder, fill: Fill,
taker: Hash,) -> bool {
    if (mode == DIRECT_FINAL_FILL) {
        if (fill.remaining != 0) || (outputs <= ob + 2) || !unique_order(order.identity, order.code,
        1, 0) {
            return false;
        }
        if !output_asset(ob, order.requested_asset, order.proceeds, fill.paid) {
            return false;
        }
        if !output_change(ob + 1, order.maker) || !output_change(ob + 2, taker) {
            return false;
        }
        return (ckb::cell_capacity(source::output(ob + 1)) == ckb::cell_capacity(source::input(ib)) + ckb::cell_capacity(source::input(ib + 1)));
    }
    if mode != DIRECT_PARTIAL_FILL {
        return false;
    }
    if (fill.remaining == 0) || (outputs <= ob + 3) || !unique_order(order.identity, order.code, 1, 1) {
        return false;
    }
    if !check_partial_successor(ib, ob, order, fill) {
        return false;
    }
    if !output_asset(ob + 2, order.requested_asset, order.proceeds, fill.paid) {
        return false;
    }
    return output_change(ob + 3, taker);
}

private fn check_wallet_fill(mode: u64, ib: u64, ob: u64, inputs: u64, outputs: u64, order: ActiveOrder,
fill: Fill, taker: Hash,) -> bool {
    let payment_input = ib + 3;
    if (inputs <= payment_input) || !input_asset(payment_input, order.requested_asset, taker) {
        return false;
    }
    let available = ckb::input::<AssetData>(payment_input).data.amount;
    if fill.paid > available {
        return false;
    }
    let final_fill = mode == FINAL_FILL;
    let mut delivery = ob;
    if final_fill {
        if (fill.remaining != 0) || (outputs <= ob + 4) || !unique_order(order.identity, order.code,
        1, 0) {
            return false;
        }
    } else {
        if (mode != PARTIAL_FILL) || (fill.remaining == 0) || (outputs <= ob + 5) || !unique_order(order.identity,
        order.code, 1, 1) {
            return false;
        }
        if !check_partial_successor(ib, ob, order, fill) {
            return false;
        }
        delivery = ob + 2;
    }
    let payment = delivery + 1;
    let payment_change = delivery + 2;
    if !output_asset(delivery, order.sold_asset, taker, fill.sold) {
        return false;
    }
    if !output_asset(payment, order.requested_asset, order.proceeds, fill.paid) {
        return false;
    }
    if !output_asset(payment_change, order.requested_asset, taker, available - fill.paid) {
        return false;
    }
    if ckb::cell_capacity(source::input(payment_input)) != ckb::cell_capacity(source::output(payment_change)) {
        return false;
    }
    let capacity_change = delivery + 3;
    if final_fill {
        if !output_change(capacity_change, order.maker) || !output_change(capacity_change + 1, taker) {
            return false;
        }
        return ckb::cell_capacity(source::output(capacity_change)) == ckb::cell_capacity(source::input(ib)) + ckb::cell_capacity(source::input(ib + 1));
    }
    return output_change(capacity_change, taker);
}

private fn check_order(mode: u64, ib: u64, ob: u64, sold: u128, paid: u128, taker: Hash, requested_issuer: Hash) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (inputs > 32) || (outputs > 32) || (ib > 29) || (ob > 29) || (mode > SHARED_PARTIAL_FILL) {
        return false;
    }
    if (mode <= CANCEL) && ((ib > 28) || (ob > 26)) {
        return false;
    }
    if (sold > 1000000000000) || (paid > 1000000000000) {
        return false;
    }
    if (ckb::cell_count(source::group_input(0)) != 1) {
        return false;
    }
    let current = source::group_input(0);
    let before = source::input(ib);
    if (ckb::cell_data_size(current) != 320) || (ckb::cell_data_size(before) != 320) {
        return false;
    }
    let configuration = ckb::cell_data_blake2b_span(current, 0, 280);
    ckb::require_cell_lock_args32(current, configuration.0);
    let controller = ckb::cell_lock_hash(current);
    let code = ckb::cell_lock_code_hash(current);
    if (ckb::cell_lock_hash_type(current) != 4) {
        return false;
    }
    ckb::require_cell_lock_hash(before, controller);
    let committed = ckb::group_input::<OrderState>(0).data;
    let order = committed.order;
    let sold_asset = committed.sold_asset;
    let requested_asset = committed.requested_asset;
    let maker = committed.maker;
    let proceeds = committed.proceeds;
    let remainder = committed.remainder;
    if (sold_asset == requested_asset) || (committed.network != network_domain()) {
        return false;
    }
    // Admission covers the requested identity already at creation, before the
    // first requested-asset wallet is ever spent by a fill. The descriptor is
    // proven against the committed complete Script hash in every mode.
    if !requested_asset_matches(requested_asset, requested_issuer) {
        return false;
    }
    let state = ckb::input::<OrderState>(ib).data;
    let numerator = state.numerator;
    let denominator = state.denominator;
    let total = state.total_sold;
    let filled = state.filled;
    let entitlement = state.entitlement;
    if (numerator == 0) || (denominator == 0) || (total == 0) {
        return false;
    }
    if (numerator > 1000000000000) || (denominator > 1000000000000) || (total > 1000000000000) {
        return false;
    }
    if (filled >= total) || (entitlement > 1000000000000) {
        return false;
    }
    if (mul_div_ceil(total, numerator, denominator) > 1000000000000) {
        return false;
    }
    if (entitlement != mul_div_ceil(filled, numerator, denominator)) {
        return false;
    }
    if mode == INITIALIZE {
        if (ib != 1) || (ob != 0) || (inputs < 3) || (outputs < 4) || (sold != 0) || (paid != 0) || (taker != maker) {
            return false;
        }
        return initialize_order(order, code, controller, maker, sold_asset, total, filled, entitlement);
    }
    if (inputs <= ib + 2) {
        return false;
    }
    ckb::require_cell_type_hash(before, order);
    ckb::require_cell_type_script_hash_type(before, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    let identity_args = ckb::cell_type_args32(before);
    ckb::require_cell_type_args32(before, identity_args);
    let remaining = total - filled;
    if !input_escrow(ib + 1, remaining, order, controller, sold_asset) {
        return false;
    }
    let predecessor_index = ckb::input_out_point_index(before) as u64;
    if (predecessor_index == 4294967295) {
        return false;
    }
    ckb::require_input_out_point(source::input(ib + 1), ckb::input_out_point_tx_hash(before), predecessor_index + 1);
    let funding = source::input(ib + 2);
    if ckb::cell_has_type(funding) || (ckb::cell_data_size(funding) != 0) {
        return false;
    }
    if (mode == CANCEL) {
        if (sold != 0) || (paid != 0) || (taker != maker) || (outputs <= ob + 1) {
            return false;
        }
        if !unique_order(order, code, 1, 0) {
            return false;
        }
        ckb::require_cell_lock_hash(funding, maker);
        if !output_asset(ob, sold_asset, remainder, remaining) {
            return false;
        }
        if (ckb::cell_capacity(source::input(ib + 1)) != ckb::cell_capacity(source::output(ob))) {
            return false;
        }
        if !output_change(ob + 1, maker) {
            return false;
        }
        return (ckb::cell_capacity(source::output(ob + 1)) >= ckb::cell_capacity(before));
    }
    if (sold == 0) || (sold > remaining) || (paid == 0) {
        return false;
    }
    ckb::require_cell_lock_hash(funding, taker);
    let next_filled = filled + sold;
    let next_entitlement = mul_div_ceil(next_filled, numerator, denominator);
    let due = next_entitlement - entitlement;
    if (due == 0) || (paid < due) {
        return false;
    }
    let active_order = new ActiveOrder {
        identity: order,
        code: code,
        controller: controller,
        configuration: configuration,
        sold_asset: sold_asset,
        requested_asset: requested_asset,
        maker: maker,
        proceeds: proceeds,
    };
    let fill = new Fill {
        sold: sold,
        paid: paid,
        filled: next_filled,
        entitlement: next_entitlement,
        remaining: total - next_filled,
    };
    if mode == SHARED_PARTIAL_FILL {
        return check_shared_fill(ib, ob, outputs, active_order, fill, taker);
    }
    if (mode == DIRECT_PARTIAL_FILL) || (mode == DIRECT_FINAL_FILL) {
        return check_direct_fill(mode, ib, ob, outputs, active_order, fill, taker);
    }
    return check_wallet_fill(mode, ib, ob, inputs, outputs, active_order, fill, taker);
}
