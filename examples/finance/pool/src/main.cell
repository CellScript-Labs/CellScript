module finance_pool;

use finance_layouts::{
    AssetData,
    PoolState,
    ReserveData,
    ShareData
};

use finance_deployment::{
    asset_code_hash,
    reserve_code_hash,
    lp_code_hash,
    minimum_code_hash,
    network_domain
};

use finance_math::{
    mul_div_floor,
    mul_div_ceil,
    isqrt
};
// Mode numbers are the public witness ABI.
private const INITIALIZE: u64 = 0;

private const SWAP_A_FOR_B: u64 = 1;

private const SWAP_B_FOR_A: u64 = 2;

private const DEPOSIT_LIQUIDITY: u64 = 3;

private const REDEEM_LIQUIDITY: u64 = 4;

private const COMPOSE_EXACT_INPUT_A_FOR_B: u64 = 5;

private const COMPOSE_EXACT_INPUT_B_FOR_A: u64 = 6;

private const COMPOSE_EXACT_OUTPUT_A_FOR_B: u64 = 7;

private const COMPOSE_EXACT_OUTPUT_B_FOR_A: u64 = 8;

private const MAX_AMOUNT: u128 = 1000000000000;

private const MINIMUM_LP: u128 = 1000;
// Bases locate the complete input and output role blocks.
public lock verify(witness mode: u64, witness input_base: u64, witness output_base: u64, witness a_max: u128,
witness b_max: u128, witness shares: u128, witness min_a: u128, witness min_b: u128, witness owner: Hash,
) -> bool {
    check_pool(mode, input_base, output_base, a_max, b_max, shares, min_a, min_b, owner)
}

private fn input_asset(index: u64, asset: Hash, owner: Hash) -> bool {
    let cell = source::input(index);
    if (ckb::cell_data_size(cell) != 16) || (ckb::input::<AssetData>(index).data.amount > MAX_AMOUNT) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_type_script_hash_type(cell, asset_code_hash(), 4);
    ckb::require_cell_lock_hash(cell, owner);
    // This named profile admits only the enforcing issuer-args32 test asset.
    let issuer = ckb::cell_type_args32(cell);
    ckb::require_cell_type_args32(cell, issuer);
    return true;
}

private fn output_asset(index: u64, asset: Hash, owner: Hash, amount: u128) -> bool {
    let cell = source::output(index);
    if (ckb::cell_data_size(cell) != 16) || (amount > MAX_AMOUNT) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_type_script_hash_type(cell, asset_code_hash(), 4);
    ckb::require_cell_lock_hash(cell, owner);
    return (ckb::output::<AssetData>(index).data.amount == amount);
}

private fn refund_asset(input_index: u64, output_index: u64, asset: Hash, owner: Hash, amount: u128) -> bool {
    if !output_asset(output_index, asset, owner, amount) {
        return false;
    }
    return (ckb::cell_capacity(source::input(input_index)) == ckb::cell_capacity(source::output(output_index)));
}

private fn output_change(index: u64, owner: Hash) -> bool {
    let cell = source::output(index);
    if ckb::cell_has_type(cell) || (ckb::cell_data_size(cell) != 0) {
        return false;
    }
    ckb::require_cell_lock_hash(cell, owner);
    return true;
}

private fn input_reserve(index: u64, amount: u128, pool: Hash, controller: Hash, asset: Hash) -> bool {
    let cell = source::input(index);
    if ckb::cell_data_size(cell) != 112 {
        return false;
    }
    let reserve = ckb::input::<ReserveData>(index).data;
    if (amount > MAX_AMOUNT) || (reserve.amount != amount) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, reserve_code_hash(), 4);
    if (reserve.pool != pool) {
        return false;
    }
    if (reserve.controller != controller) {
        return false;
    }
    if (reserve.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn output_reserve(index: u64, amount: u128, pool: Hash, controller: Hash, asset: Hash) -> bool {
    let cell = source::output(index);
    if ckb::cell_data_size(cell) != 112 {
        return false;
    }
    let reserve = ckb::output::<ReserveData>(index).data;
    if (amount > MAX_AMOUNT) || (reserve.amount != amount) {
        return false;
    }
    ckb::require_cell_type_hash(cell, asset);
    ckb::require_cell_lock_script_hash_type(cell, reserve_code_hash(), 4);
    if (reserve.pool != pool) {
        return false;
    }
    if (reserve.controller != controller) {
        return false;
    }
    if (reserve.asset != asset) {
        return false;
    }
    ckb::require_cell_lock_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 96).0);
    return true;
}

private fn input_shares(index: u64, amount: u128, pool: Hash, pool_code: Hash, lp: Hash, owner: Hash) -> bool {
    let cell = source::input(index);
    if ckb::cell_data_size(cell) != 80 {
        return false;
    }
    let shares = ckb::input::<ShareData>(index).data;
    if (amount > MAX_AMOUNT) || (shares.amount != amount) {
        return false;
    }
    ckb::require_cell_type_hash(cell, lp);
    ckb::require_cell_lock_hash(cell, owner);
    ckb::require_cell_type_script_hash_type(cell, lp_code_hash(), 4);
    if (shares.pool != pool) {
        return false;
    }
    if (shares.pool_code != pool_code) {
        return false;
    }
    ckb::require_cell_type_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 64).0);
    return true;
}

private fn output_shares(index: u64, amount: u128, pool: Hash, pool_code: Hash, lp: Hash, owner: Hash) -> bool {
    let cell = source::output(index);
    if ckb::cell_data_size(cell) != 80 {
        return false;
    }
    let shares = ckb::output::<ShareData>(index).data;
    if (amount > MAX_AMOUNT) || (shares.amount != amount) {
        return false;
    }
    ckb::require_cell_type_hash(cell, lp);
    ckb::require_cell_lock_hash(cell, owner);
    ckb::require_cell_type_script_hash_type(cell, lp_code_hash(), 4);
    if (shares.pool != pool) {
        return false;
    }
    if (shares.pool_code != pool_code) {
        return false;
    }
    ckb::require_cell_type_args32(cell, ckb::cell_data_blake2b_span(cell, 16, 64).0);
    return true;
}

private fn unique_state(pool: Hash, expected_inputs: u64) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    let mut found_input = 0;
    let mut found_output = 0;
    let mut i = 0;
    while (i < inputs) {
        let cell = source::input(i);
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == pool) {
                found_input = found_input + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < outputs) {
        let cell = source::output(i);
        if ckb::cell_has_type(cell) {
            if (ckb::cell_type_hash(cell) == pool) {
                found_output = found_output + 1;
            }
        }
        i = i + 1;
    }
    return (found_input == expected_inputs) && (found_output == 1);
}

private struct PoolAssets {
    pool: Hash,
    code: Hash,
    asset_a: Hash,
    asset_b: Hash,
    lp: Hash,
}

private struct PoolBalances {
    reserve_a: u128,
    reserve_b: u128,
    total_lp: u128,
}

private struct SwapSide {
    asset: Hash,
    input_index: u64,
    output_index: u64,
    provided: u128,
    prior_reserve: u128,
    next_reserve: u128,
}

private fn initialize_pool(a: u128, b: u128, supply: u128, minimum_shares: u128, pool: Hash, pool_code: Hash,
asset_a: Hash, asset_b: Hash, lp: Hash, minimum_lock: Hash, owner: Hash,) -> bool {
    let before = source::input(1);
    let after = source::output(0);
    if ckb::cell_has_type(before) || !unique_state(pool, 0) {
        return false;
    }
    ckb::require_cell_lock_hash(source::input(0), owner);
    if ckb::cell_has_type(source::input(0)) || (ckb::cell_data_size(source::input(0)) != 0) {
        return false;
    }
    if (ckb::cell_data_hash_field(before) != ckb::cell_data_hash_field(after)) {
        return false;
    }
    if (ckb::input::<PoolState>(1).data.revision != 0) {
        return false;
    }
    if (supply != isqrt(a * b)) || (supply <= MINIMUM_LP) || (supply - MINIMUM_LP < minimum_shares) {
        return false;
    }
    if !input_asset(2, asset_a, owner) || !input_asset(3, asset_b, owner) {
        return false;
    }
    let provided_a = ckb::input::<AssetData>(2).data.amount;
    let provided_b = ckb::input::<AssetData>(3).data.amount;
    if (provided_a < a) || (provided_b < b) {
        return false;
    }
    if !refund_asset(2, 3, asset_a, owner, provided_a - a) {
        return false;
    }
    if !refund_asset(3, 4, asset_b, owner, provided_b - b) {
        return false;
    }
    if !output_shares(5, supply - MINIMUM_LP, pool, pool_code, lp, owner) {
        return false;
    }
    if !output_shares(6, MINIMUM_LP, pool, pool_code, lp, minimum_lock) {
        return false;
    }
    ckb::require_cell_lock_script_hash_type(source::output(6), minimum_code_hash(), 4);
    ckb::require_cell_lock_args_empty(source::output(6));
    return output_change(7, owner);
}

private fn redeem_liquidity(ib: u64, ob: u64, outputs: u64, assets: PoolAssets, prior: PoolBalances,
next: PoolBalances, shares_to_burn: u128, minimum_a: u128, minimum_b: u128, owner: Hash,) -> bool {
    if (shares_to_burn == 0) || (shares_to_burn > prior.total_lp - MINIMUM_LP) {
        return false;
    }
    let shares_input = source::input(ib + 4);
    if ckb::cell_data_size(shares_input) != 80 {
        return false;
    }
    let supplied_shares = ckb::input::<ShareData>(ib + 4).data.amount;
    if (supplied_shares > MAX_AMOUNT) || (supplied_shares < shares_to_burn) {
        return false;
    }
    if !input_shares(ib + 4, supplied_shares, assets.pool, assets.code, assets.lp, owner) {
        return false;
    }
    let returned_a = mul_div_floor(shares_to_burn, prior.reserve_a, prior.total_lp);
    let returned_b = mul_div_floor(shares_to_burn, prior.reserve_b, prior.total_lp);
    if (returned_a == 0) || (returned_b == 0) || (returned_a < minimum_a) || (returned_b < minimum_b) {
        return false;
    }
    if (next.reserve_a != prior.reserve_a - returned_a) || (next.reserve_b != prior.reserve_b - returned_b) || (next.total_lp != prior.total_lp - shares_to_burn) {
        return false;
    }
    if !output_asset(ob + 3, assets.asset_a, owner, returned_a) || !output_asset(ob + 4, assets.asset_b,
    owner, returned_b) {
        return false;
    }
    if (supplied_shares == shares_to_burn) {
        if !output_change(ob + 5, owner) {
            return false;
        }
        return (ckb::cell_capacity(source::output(ob + 5)) >= ckb::cell_capacity(source::input(ib + 4)));
    }
    if (outputs <= ob + 6) {
        return false;
    }
    if !output_shares(ob + 5, supplied_shares - shares_to_burn, assets.pool, assets.code, assets.lp,
    owner) {
        return false;
    }
    if (ckb::cell_capacity(source::input(ib + 4)) != ckb::cell_capacity(source::output(ob + 5))) {
        return false;
    }
    return output_change(ob + 6, owner);
}

private fn deposit_liquidity(ib: u64, ob: u64, outputs: u64, assets: PoolAssets, prior: PoolBalances,
next: PoolBalances, provided_a: u128, provided_b: u128, maximum_a: u128, maximum_b: u128, minimum_shares: u128,
owner: Hash,) -> bool {
    if (maximum_a > provided_a) || (maximum_b > provided_b) {
        return false;
    }
    let from_a = mul_div_floor(maximum_a, prior.total_lp, prior.reserve_a);
    let from_b = mul_div_floor(maximum_b, prior.total_lp, prior.reserve_b);
    let mut minted = from_a;
    if (from_b < minted) {
        minted = from_b;
    }
    if (minted == 0) || (minted < minimum_shares) || (minted > MAX_AMOUNT - prior.total_lp) {
        return false;
    }
    let used_a = mul_div_ceil(minted, prior.reserve_a, prior.total_lp);
    let used_b = mul_div_ceil(minted, prior.reserve_b, prior.total_lp);
    if (used_a > maximum_a) || (used_b > maximum_b) {
        return false;
    }
    if (next.reserve_a != prior.reserve_a + used_a) || (next.reserve_b != prior.reserve_b + used_b) || (next.total_lp != prior.total_lp + minted) {
        return false;
    }
    if !refund_asset(ib + 4, ob + 3, assets.asset_a, owner, provided_a - used_a) {
        return false;
    }
    if !refund_asset(ib + 5, ob + 4, assets.asset_b, owner, provided_b - used_b) {
        return false;
    }
    if (outputs <= ob + 6) || !output_shares(ob + 5, minted, assets.pool, assets.code, assets.lp, owner) {
        return false;
    }
    return output_change(ob + 6, owner);
}

private fn check_exact_input_leg(reserve_in: u128, reserve_out: u128, next_in: u128, next_out: u128,
amount_in: u128, minimum_out: u128, fee: u64,) -> bool {
    if amount_in == 0 {
        return false;
    }
    let scaled = amount_in * (10000 - fee) as u128;
    let received = mul_div_floor(reserve_out, scaled, reserve_in * 10000 + scaled);
    if (received == 0) || (received < minimum_out) || (received >= reserve_out) {
        return false;
    }
    return (next_in == reserve_in + amount_in) && (next_out == reserve_out - received);
}

private fn check_exact_output_leg(reserve_in: u128, reserve_out: u128, next_in: u128, next_out: u128,
maximum_in: u128, desired_out: u128, fee: u64,) -> bool {
    if (maximum_in == 0) || (desired_out == 0) || (desired_out >= reserve_out) {
        return false;
    }
    let denominator = (reserve_out - desired_out) * (10000 - fee) as u128;
    let required = mul_div_ceil(reserve_in, desired_out * 10000, denominator);
    if (required == 0) || (required > maximum_in) {
        return false;
    }
    // Rounding surplus remains in the pool.
    return (next_in == reserve_in + required) && (next_out == reserve_out - desired_out);
}

private fn swap_exact_input(sold: SwapSide, bought: SwapSide, amount_in: u128, minimum_out: u128, fee: u64,
owner: Hash, change_index: u64) -> bool {
    if (amount_in == 0) || (sold.provided < amount_in) {
        return false;
    }
    let scaled = amount_in * (10000 - fee) as u128;
    let received = mul_div_floor(bought.prior_reserve, scaled, sold.prior_reserve * 10000 + scaled);
    if (received == 0) || (received < minimum_out) || (received >= bought.prior_reserve) {
        return false;
    }
    if (sold.next_reserve != sold.prior_reserve + amount_in) || (bought.next_reserve != bought.prior_reserve - received) {
        return false;
    }
    if !refund_asset(sold.input_index, sold.output_index, sold.asset, owner, sold.provided - amount_in) {
        return false;
    }
    if !refund_asset(bought.input_index, bought.output_index, bought.asset, owner, bought.provided + received) {
        return false;
    }
    return output_change(change_index, owner);
}

private fn check_pool(mode: u64, ib: u64, ob: u64, a_max: u128, b_max: u128, shares: u128, min_a: u128,
min_b: u128, owner: Hash) -> bool {
    let inputs = ckb::cell_count(source::input(0));
    let outputs = ckb::cell_count(source::output(0));
    if (inputs > 32) || (outputs > 32) || (ib > 29) || (ob > 29) || (mode > COMPOSE_EXACT_OUTPUT_B_FOR_A) {
        return false;
    }
    if (mode <= REDEEM_LIQUIDITY) && ((ib > 25) || (ob > 24)) {
        return false;
    }
    if (a_max > MAX_AMOUNT) || (b_max > MAX_AMOUNT) || (shares > MAX_AMOUNT) {
        return false;
    }
    if (min_a > MAX_AMOUNT) || (min_b > MAX_AMOUNT) {
        return false;
    }
    if (ckb::cell_count(source::group_input(0)) != 1) {
        return false;
    }
    let current = source::group_input(0);
    let before = source::input(ib);
    let after = source::output(ob);
    if (ckb::cell_data_size(current) != 264) || (ckb::cell_data_size(before) != 264) || (ckb::cell_data_size(after) != 264) {
        return false;
    }
    let configuration = ckb::cell_data_blake2b_span(current, 0, 208);
    ckb::require_cell_lock_args32(current, configuration.0);
    if (ckb::cell_data_blake2b_span(after, 0, 208) != configuration) {
        return false;
    }
    let controller = ckb::cell_lock_hash(current);
    let pool_code = ckb::cell_lock_code_hash(current);
    if (ckb::cell_lock_hash_type(current) != 4) {
        return false;
    }
    ckb::require_cell_lock_hash(before, controller);
    ckb::require_cell_lock_hash(after, controller);
    if (ckb::cell_capacity(before) != ckb::cell_capacity(after)) {
        return false;
    }
    let committed = ckb::group_input::<PoolState>(0).data;
    let pool = committed.pool;
    let asset_a = committed.asset_a;
    let asset_b = committed.asset_b;
    let lp = committed.lp;
    let minimum_lock = committed.minimum_lock;
    if (asset_a == asset_b) || (committed.network != network_domain()) {
        return false;
    }
    let fee = committed.fee;
    if (fee > 1000) {
        return false;
    }
    ckb::require_cell_type_hash(after, pool);
    ckb::require_cell_type_script_hash_type(after, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    let prior = ckb::input::<PoolState>(ib).data;
    let successor = ckb::output::<PoolState>(ob).data;
    let a = prior.reserve_a;
    let b = prior.reserve_b;
    let supply = prior.total_lp;
    let next_a = successor.reserve_a;
    let next_b = successor.reserve_b;
    let next_supply = successor.total_lp;
    if (a == 0) || (b == 0) || (a > MAX_AMOUNT) || (b > MAX_AMOUNT) || (supply < MINIMUM_LP) || (supply > MAX_AMOUNT) {
        return false;
    }
    if (next_a == 0) || (next_b == 0) || (next_a > MAX_AMOUNT) || (next_b > MAX_AMOUNT) {
        return false;
    }
    if (next_supply < MINIMUM_LP) || (next_supply > MAX_AMOUNT) {
        return false;
    }
    let reserve_a_in = ib + 1;
    let reserve_b_in = ib + 2;
    let reserve_a_out = ob + 1;
    let reserve_b_out = ob + 2;
    if !output_reserve(reserve_a_out, next_a, pool, controller, asset_a) {
        return false;
    }
    if !output_reserve(reserve_b_out, next_b, pool, controller, asset_b) {
        return false;
    }
    if mode == INITIALIZE {
        if (ib != 1) || (ob != 0) || (inputs < 4) || (outputs < 8) {
            return false;
        }
        if (min_a != 0) || (min_b != 0) || (a != a_max) || (b != b_max) {
            return false;
        }
        return initialize_pool(a, b, supply, shares, pool, pool_code, asset_a, asset_b, lp, minimum_lock,
        owner);
    }
    if (inputs <= ib + 2) || (outputs <= ob + 2) || !unique_state(pool, 1) {
        return false;
    }
    ckb::require_cell_type_hash(before, pool);
    ckb::require_cell_type_script_hash_type(before, Hash::from_bytes(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00TYPE_ID"),
    1);
    let identity_args = ckb::cell_type_args32(before);
    ckb::require_cell_type_args32(before, identity_args);
    let revision = prior.revision;
    if (revision == 18446744073709551615) || (successor.revision != revision + 1) {
        return false;
    }
    if !input_reserve(reserve_a_in, a, pool, controller, asset_a) {
        return false;
    }
    if !input_reserve(reserve_b_in, b, pool, controller, asset_b) {
        return false;
    }
    // Only actual siblings from the preceding pool transaction are inventory.
    // An unsolicited equal-looking reserve cannot replace either predecessor.
    let predecessor = ckb::input_out_point_tx_hash(before);
    let predecessor_index = ckb::input_out_point_index(before) as u64;
    if (predecessor_index > 4294967293) {
        return false;
    }
    ckb::require_input_out_point(source::input(reserve_a_in), predecessor, predecessor_index + 1);
    ckb::require_input_out_point(source::input(reserve_b_in), predecessor, predecessor_index + 2);
    if (ckb::cell_capacity(source::input(reserve_a_in)) != ckb::cell_capacity(source::output(reserve_a_out))) {
        return false;
    }
    if (ckb::cell_capacity(source::input(reserve_b_in)) != ckb::cell_capacity(source::output(reserve_b_out))) {
        return false;
    }
    if mode >= COMPOSE_EXACT_INPUT_A_FOR_B {
        // Asset Type groups conserve the full transaction. The application
        // spending the trader's Cells binds the destination and user limits.
        if (owner != Hash::zero()) || (shares != 0) || (next_supply != supply) {
            return false;
        }
        if mode == COMPOSE_EXACT_INPUT_A_FOR_B {
            if (b_max != 0) || (min_a != 0) {
                return false;
            }
            return check_exact_input_leg(a, b, next_a, next_b, a_max, min_b, fee);
        }
        if mode == COMPOSE_EXACT_INPUT_B_FOR_A {
            if (a_max != 0) || (min_b != 0) {
                return false;
            }
            return check_exact_input_leg(b, a, next_b, next_a, b_max, min_a, fee);
        }
        if (min_a != 0) || (min_b != 0) {
            return false;
        }
        if mode == COMPOSE_EXACT_OUTPUT_A_FOR_B {
            return check_exact_output_leg(a, b, next_a, next_b, a_max, b_max, fee);
        }
        return check_exact_output_leg(b, a, next_b, next_a, b_max, a_max, fee);
    }
    if (inputs <= ib + 4) || (outputs <= ob + 5) {
        return false;
    }
    let funding = source::input(ib + 3);
    ckb::require_cell_lock_hash(funding, owner);
    if ckb::cell_has_type(funding) || (ckb::cell_data_size(funding) != 0) {
        return false;
    }
    let pool_assets = new PoolAssets {
        pool: pool,
        code: pool_code,
        asset_a: asset_a,
        asset_b: asset_b,
        lp: lp,
    };
    let prior_balances = new PoolBalances {
        reserve_a: a,
        reserve_b: b,
        total_lp: supply,
    };
    let next_balances = new PoolBalances {
        reserve_a: next_a,
        reserve_b: next_b,
        total_lp: next_supply,
    };
    if mode == REDEEM_LIQUIDITY {
        if (a_max != 0) || (b_max != 0) {
            return false;
        }
        return redeem_liquidity(ib, ob, outputs, pool_assets, prior_balances, next_balances, shares,
        min_a, min_b, owner);
    }
    if (inputs <= ib + 5) {
        return false;
    }
    if !input_asset(ib + 4, asset_a, owner) || !input_asset(ib + 5, asset_b, owner) {
        return false;
    }
    let provided_a = ckb::input::<AssetData>(ib + 4).data.amount;
    let provided_b = ckb::input::<AssetData>(ib + 5).data.amount;
    if mode == DEPOSIT_LIQUIDITY {
        if (min_a != 0) || (min_b != 0) {
            return false;
        }
        return deposit_liquidity(ib, ob, outputs, pool_assets, prior_balances, next_balances, provided_a,
        provided_b, a_max, b_max, shares, owner);
    }
    if (shares != 0) || (next_supply != supply) {
        return false;
    }
    let wallet_a = new SwapSide {
        asset: asset_a,
        input_index: ib + 4,
        output_index: ob + 3,
        provided: provided_a,
        prior_reserve: a,
        next_reserve: next_a,
    };
    let wallet_b = new SwapSide {
        asset: asset_b,
        input_index: ib + 5,
        output_index: ob + 4,
        provided: provided_b,
        prior_reserve: b,
        next_reserve: next_b,
    };
    if mode == SWAP_A_FOR_B {
        if (b_max != 0) || (min_a != 0) {
            return false;
        }
        return swap_exact_input(wallet_a, wallet_b, a_max, min_b, fee, owner, ob + 5);
    }
    if (mode != SWAP_B_FOR_A) || (a_max != 0) || (min_b != 0) {
        return false;
    }
    return swap_exact_input(wallet_b, wallet_a, b_max, min_a, fee, owner, ob + 5);
}
