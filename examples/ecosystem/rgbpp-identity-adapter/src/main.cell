module cellscript::ecosystem::rgbpp_identity_adapter

// This sidecar policy Cell commits the selected RGB++ lock deployment and the
// exact 36-byte input/output bindings. It validates transaction indexes 1/1;
// the official Rgbpp Lock, BTC SPV, witnesses, and builder remain authoritative.
resource RgbppIdentityPolicy has store, create, replace
    identity(field(policy_id))
{
    policy_id: Hash,
    rgbpp_lock_code_hash: Hash,
    rgbpp_lock_hash_type: u64,
    input_lock_args: [u8; 36],
    output_lock_args: [u8; 36],
}

action require_rgbpp_lock_transition(policy_before: RgbppIdentityPolicy) -> policy_after: RgbppIdentityPolicy {
    transition policy_before -> policy_after

    verification
        require policy_after.policy_id == policy_before.policy_id
        require policy_after.rgbpp_lock_code_hash == policy_before.rgbpp_lock_code_hash
        require policy_after.rgbpp_lock_hash_type == policy_before.rgbpp_lock_hash_type
        require policy_after.input_lock_args == policy_before.input_lock_args
        require policy_after.output_lock_args == policy_before.output_lock_args

        let rgbpp_input = source::input(1)
        let rgbpp_output = source::output(1)
        let expected_input_lock = script::new(
            policy_before.rgbpp_lock_code_hash,
            policy_before.rgbpp_lock_hash_type,
            script::args(policy_before.input_lock_args),
        )
        let expected_output_lock = script::new(
            policy_before.rgbpp_lock_code_hash,
            policy_before.rgbpp_lock_hash_type,
            script::args(policy_before.output_lock_args),
        )
        script::require_cell_lock_matches(rgbpp_input, expected_input_lock)
        script::require_cell_lock_matches(rgbpp_output, expected_output_lock)
}
