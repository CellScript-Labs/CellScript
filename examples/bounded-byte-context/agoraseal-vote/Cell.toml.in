[package]
name = "agoraseal-vote"
version = "0.1.0"
edition = "2026"

[dependencies]

[[deploy.ckb.trusted_external_verifiers]]
schema = "cellscript-trusted-external-verifier-v1"
name = "ckb-direct-prefix-context-v1"
scope = "action:cast"
operation = "spawn-wait"
adapter = "hex4-v1"
code_hash = "@CONTEXT_HASH@"
hash_type = "data"
source_identity = "AgoraSeal 5b6106a7b86d51b736a7df772ded548fba4c9a4e verifiers/ckb-context; vendored fixture build_reproducible.sh and checked child.hex"
applicability = "Raw direct CellDeps 0 and 1, first OutPoint and both creation block numbers; transaction <= 65536 bytes and <= 128 deps"
trust_basis = "Pinned source and Cargo.lock; real parent-child CKB-VM mutation tests; independent security review pending"
guarantees = [
  "Raw first two CellDeps are distinct direct references with no duplicate dependency OutPoints",
  "First raw dependency OutPoint equals the 36-byte argument",
  "Both claimed block numbers equal LOAD_HEADER results for the corresponding resolved CellDeps",
  "No voting, DAO eligibility, ownership, amount or snapshot comparison is delegated",
]
