module cellscript::language::ownership::identity_lifecycle;
// Creation and retirement declare identity policies explicitly. The unique
// replacement examples check continuity using three identity strategies.
# [type_id("cellscript::language::ownership::identity_lifecycle::TypedToken:v1")] resource TypedToken has store,
create, consume, replace, burn, relock identity(ckb_type_id) {
    amount: u64,
}

resource UniqueNFT has store, create, consume, replace, burn, relock identity(field(token_id)) {
    token_id: u64,
    owner: Address,
}

resource InstanceItem has store, create, consume, replace, burn, relock identity(script_args) {
    item_id: u64,
    data: Hash,
}

action mint_typed_token(witness recipient: Address, witness amount: u64,  output minted: TypedToken) {
    fresh minted {
        data {
            amount = amount,
        };
        identity = ckb_type_id;
        lock = exact(recipient);
    }
}

action transfer_typed_token(input token: TypedToken, witness to: Address) -> TypedToken {
    replace_unique::< TypedToken > (identity = ckb_type_id) token {
        amount: token.amount
    }
}

action burn_typed_token(input token: TypedToken) {
    retire token {
        absence = singleton_type;
    }
}

action mint_unique_nft(witness recipient: Address, witness tid: u64,  output minted: UniqueNFT) {
    fresh minted {
        data {
            token_id = tid,
            owner = recipient,
        };
        identity = field(token_id);
        lock = exact(recipient);
    }
}

action transfer_unique_nft(input nft: UniqueNFT, witness to: Address) -> UniqueNFT {
    replace_unique::< UniqueNFT > (identity = field(token_id)) nft {
        token_id: nft.token_id,
        owner: to
    }
}

action destroy_unique_nft(input nft: UniqueNFT) {
    retire nft {
        absence = ckb_type_id;
    }
}

action update_instance(input item: InstanceItem, witness new_data: Hash) -> InstanceItem {
    replace_unique::< InstanceItem > (identity = script_args) item {
        item_id: item.item_id,
        data: new_data
    }
}

action destroy_instance_item(input item: InstanceItem) {
    retire item {
        absence = field(item_id);
    }
}

action burn_item_quantity(input item: InstanceItem) {
    burn_amount(item, field = item_id);
}
