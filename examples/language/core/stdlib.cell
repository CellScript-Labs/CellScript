module cellscript::language::core::stdlib;

resource Coin has store, create, consume, replace, burn, relock {
    amount: u64,
    nonce: u64,
}

receipt Voucher -> Coin has create, consume, burn {
    amount: u64,
    nonce: u64,
    holder: Address,
}
// Constraint patterns — expand to require constraints
action coin_preserve_type(input coin_before: Coin,  output coin_after: Coin) {
    std::cell::preserve_type(coin_after, coin_before)
}

action coin_same_lock(input coin_before: Coin,  output coin_after: Coin) {
    std::cell::same_lock(coin_after, coin_before)
}

action coin_preserve_lock(input coin_before: Coin,  output coin_after: Coin) {
    std::cell::preserve_lock(coin_after, coin_before)
}

action coin_preserve_capacity(input coin_before: Coin,  output coin_after: Coin) {
    std::cell::preserve_capacity(coin_after, coin_before)
}

action coin_conserved(input coin_before: Coin,  output coin_after: Coin) {
    std::accounting::conserved(coin_after, coin_before)
}
// Lifecycle patterns — consume + canonical output/constraint patterns
action transfer_coin(input coin: Coin, witness to: Address,  output next_coin: Coin) {
    std::lifecycle::transfer(coin, next_coin, to) {
        amount,
        nonce,
    }
}

action claim_voucher(input voucher: Voucher,  output coin: Coin) {
    std::receipt::claim(voucher, coin, voucher.holder) {
        amount,
        nonce,
    }
}

action settle_voucher(input voucher: Voucher,  output coin: Coin) {
    std::lifecycle::settle(voucher, coin, voucher.holder) {
        amount,
        nonce,
    }
}
