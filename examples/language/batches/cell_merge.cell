module cellscript::language::batches::cell_merge;
// Merge two through 128 fragmented Cells into exactly one output. The per-item
// upper bound makes the u64 accumulator safe, while the single-element output
// plan binds the aggregate amount to the resulting Cell.
struct MergePlan {
    owner: Address,
    amount: u64,
}

resource Fragment has store, consume {
    amount: u64,
}

resource MergedCell has store, create with_capacity_floor(10000000000) {
    amount: u64,
}

action merge_cells(input fragments: BoundedCellSet<Fragment, 128>, witness outputs: BoundedList<MergePlan,
1>,) -> u64 {
    let mut merged_amount: u64 = 0;
    let mut fragment_count: u64 = 0;
    consume_each fragment in fragments {
        require fragment.amount > 0;
        require fragment.amount <= 100000000000000000;
        merged_amount += fragment.amount;
        fragment_count += 1;
    }
    let mut output_count: u64 = 0;
    create_each output in outputs {
        require output.amount == merged_amount;
        output_count += 1;
        create MergedCell {
            amount: output.amount,
        } with_lock(output.owner)
    }
    require fragment_count >= 2;
    require output_count == 1;
    return 0;
}
