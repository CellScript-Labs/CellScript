module cellscript::examples::semantic_foundation_2027;

resource Token has store, replace, relock {
    owner: Address,
    amount: u64,
}

action transfer(input token: Token, witness recipient: Address, output next: Token,) {
    require token.amount > 0;
    replace token -> next {
        data {
            owner = same,
            amount = same,
        };
        type_script = same;
        lock = exact(recipient);
        capacity = same;
    }
}
