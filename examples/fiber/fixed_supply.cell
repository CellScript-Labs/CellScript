module cellscript::fiber::fixed_supply;

invariant fixed_asset_conservation {
    trigger: type_group;
    scope: group;
    reads: group_inputs < FixedAsset >.quantity,
    group_outputs < FixedAsset >.quantity;
    assert_sum(group_outputs < FixedAsset >.quantity) == assert_sum(group_inputs < FixedAsset >.quantity);
}

resource FixedAsset has store, create, consume {
    quantity: u128,
}

# [type_id("cellscript::fiber::fixed_supply::OneShotGenesisAuthority:v1")] resource OneShotGenesisAuthority has store,
create, consume, burn identity(ckb_type_id) {
    initial_supply: u128,
}

action create_genesis_authority(witness initial_supply: u128, witness controller: Address,  output authority: OneShotGenesisAuthority) {
    require initial_supply > 0,
    "initial supply must be positive";
    fresh authority {
        data {
            initial_supply = initial_supply,
        };
        identity = ckb_type_id;
        lock = exact(controller);
    }
}

action initialize(input authority: OneShotGenesisAuthority, witness recipient: Address,  output asset: FixedAsset) {
    require authority.initial_supply > 0,
    "initial supply must be positive";
    retire authority {
        absence = singleton_type;
    }
    create asset = FixedAsset {
        quantity: authority.initial_supply,
    } with_lock(recipient)
}

action transfer(input asset: FixedAsset, witness recipient: Address,  output next: FixedAsset) {
    consume asset;
    create next = FixedAsset {
        quantity: asset.quantity,
    } with_lock(recipient)
}
