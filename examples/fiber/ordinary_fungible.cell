module cellscript::fiber::ordinary_fungible

invariant quantity_conservation {
    trigger: type_group
    scope: group
    reads: group_inputs<FiberToken>.quantity, group_outputs<FiberToken>.quantity
    assert_sum(group_outputs<FiberToken>.quantity) == assert_sum(group_inputs<FiberToken>.quantity)
}

resource FiberToken has store, create, consume {
    quantity: u128,
}

action transfer(token: FiberToken, to: Address) -> next: FiberToken {
    verification
        consume token
        create next = FiberToken { quantity: token.quantity } with_lock(to)
}
