module cellscript::fiber::governed_supply_cap;

invariant stablecoin_conservation {
    trigger: type_group;
    scope: group;
    reads: group_inputs < GovernedUsd >.quantity,
    group_outputs < GovernedUsd >.quantity;
    assert_sum(group_outputs < GovernedUsd >.quantity) == assert_sum(group_inputs < GovernedUsd >.quantity);
}

resource GovernedUsd has store, create, consume, burn {
    quantity: u128,
}

# [type_id("cellscript::fiber::governed_supply_cap::SupplyPolicy:v1")] resource SupplyPolicy has store,
create, consume, replace identity(ckb_type_id) {
    cap: u128,
    issued: u128,
}

action create_policy(witness cap: u128, witness controller: Address,  output policy: SupplyPolicy) {
    require cap > 0,
    "cap must be positive";
    fresh policy {
        data {
            cap = cap,
            issued = 0,
        };
        identity = ckb_type_id;
        lock = exact(controller);
    }
}

action issue(input policy_before: SupplyPolicy, witness recipient: Address, witness quantity: u128,  output policy_after: SupplyPolicy,
output asset: GovernedUsd) {
    transition policy_before -> policy_after;
    require policy_before.issued <= policy_before.cap,
    "invalid policy state";
    require quantity <= policy_before.cap - policy_before.issued,
    "supply cap exceeded";
    require policy_after.cap == policy_before.cap,
    "cap changed";
    require policy_after.issued == policy_before.issued + quantity,
    "issued supply mismatch";
    create asset = GovernedUsd {
        quantity,
    } with_lock(recipient)
}

action redeem(input policy_before: SupplyPolicy, input asset: GovernedUsd,  output policy_after: SupplyPolicy) {
    transition policy_before -> policy_after;
    require asset.quantity <= policy_before.issued,
    "redeem exceeds issued supply";
    require policy_after.cap == policy_before.cap,
    "cap changed";
    require policy_after.issued == policy_before.issued - asset.quantity,
    "issued supply mismatch";
    destroy asset;
}
